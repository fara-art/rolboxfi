	ru = {
		pair = "Двойная звезда", triangle = "Летний треугольник", belt = "Пояс Ориона", pegasus = "Квадрат Пегаса",
		rhombus = "Ромб Дельфина", cross = "Южный Крест", cassiopeia = "Кассиопея", dipper = "Большая Медведица", ring = "Кольцо Галактики",
	},
