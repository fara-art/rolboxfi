<Item class="ReplicatedStorage" referent="RBX21"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX20"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[local Config = {}

-- Rolling
Config.AutoRollUnlock = 50 -- total rolls needed to unlock auto roll
Config.MaxRollSpeedLevel = 10
function Config.RollCooldown(level: number): number
	return math.max(0.3, 1 * 0.88 ^ level)
end
function Config.RollSpeedCost(level: number): number
	return math.floor(400 * 2.6 ^ level)
end
Config.MaxMultiRollLevel = 4 -- rolls per click = 1 + level
function Config.MultiRollCost(level: number): number
	return math.floor(5000 * 8 ^ level)
end

-- Plot (pedestal grid)
Config.StartGridSize = 4
Config.MaxGridSize = 8
function Config.GridCost(size: number): number
	return math.floor(1000 * 8 ^ (size - Config.StartGridSize))
end
Config.PlotReach = 52 -- how far from plot center you can place stars / build

-- Build mode: stars can only stand on slabs. Better slabs multiply the star's income.
Config.Slabs = {
	{ id = "stone", cost = 100, mult = 1, color = Color3.fromRGB(150, 152, 165), material = Enum.Material.Slate },
	{ id = "gold", cost = 50000, mult = 1.5, color = Color3.fromRGB(245, 196, 80), material = Enum.Material.Foil },
	{ id = "emerald", cost = 5000000, mult = 2.5, color = Color3.fromRGB(60, 210, 130), material = Enum.Material.Glass },
	{ id = "marble", cost = 1000000000, mult = 4, color = Color3.fromRGB(246, 246, 252), material = Enum.Material.Marble },
}
Config.SlabsById = {}
for index, slab in Config.Slabs do
	slab.index = index
	Config.SlabsById[slab.id] = slab
end
Config.FreeStoneSlabs = 4 -- new players start with these
Config.SlabRefund = 0.5 -- removing a slab gives back this share of its price

-- Movement
Config.WalkSpeed = 16
Config.SprintSpeed = 30

-- Luck
Config.LuckPerLevel = 0.5
Config.MaxLuckLevel = math.huge -- no limit
function Config.LuckCost(level: number): number
	return math.floor(150 * 1.6 ^ level)
end

Config.SellMultiplier = 20 -- sell value = income/s * this (also Black Hole mass)

-- Star Forge: ForgeAmount of the same item -> 1 of the next star (mutation kept)
Config.ForgeAmount = 5
Config.ForgeCostMult = 10 -- cash cost = next star income * this
Config.ForgeReach = 26

-- Black Hole / Rebirth
function Config.RebirthCost(rebirths: number): number
	return math.floor(100000 * 10 ^ rebirths)
end
Config.RebirthIncomeBonus = 2 -- income x(1 + rebirths * this)
Config.RebirthLuckMult = 0.5 -- luck x(1 + rebirths * this)
Config.AltarReach = 30

-- Star Index: split into tiers; each tier has a row per mutation. A complete row -> permanent luck.
do
	local Stars = require(script.Parent.Stars)
	Config.IndexTiers = {}
	local perTier = 9
	for first = 1, #Stars.List, perTier do
		local number = #Config.IndexTiers + 1
		table.insert(Config.IndexTiers, {
			first = first,
			last = math.min(first + perTier - 1, #Stars.List),
			luck = math.floor(0.25 * 1.8 ^ (number - 1) * 100) / 100,
		})
	end
end
-- extra luck for a row with a rarer mutation: luck * this
Config.IndexMutationMult = { normal = 1, shiny = 2, golden = 4, void = 8, celestial = 16 }

-- Constellations (shape bonuses) are switched off for now; flip to true to bring them back
Config.ConstellationsEnabled = false

-- Roll milestones (Roll Rewards window). Reward: cash / luck / item (+ count)
Config.RollMilestones = {
	{ rolls = 50, cash = 500 },
	{ rolls = 100, item = "sun", count = 1 },
	{ rolls = 250, luck = 0.25 },
	{ rolls = 500, item = "giant", count = 1 },
	{ rolls = 1000, cash = 50000 },
	{ rolls = 2500, item = "giant|golden", count = 1 },
	{ rolls = 5000, luck = 1 },
	{ rolls = 10000, item = "pulsar|shiny", count = 1 },
	{ rolls = 25000, cash = 5000000 },
	{ rolls = 50000, item = "neutron|golden", count = 1 },
	{ rolls = 100000, luck = 3 },
}

-- Star Shower: server-wide luck event
Config.ShowerInterval = 600
Config.ShowerDuration = 180
Config.ShowerLuck = 2

Config.AnnounceChance = 10000 -- announce items rarer than 1 in N
Config.GlobalRareChance = 1000000000 -- 1 in a billion and rarer: cinematic for the whole server

-- Admin panel: the game owner (if the game belongs to a user), these user IDs, and anyone in Studio tests
Config.AdminUserIds = {}

Config.AutosaveInterval = 120
Config.DataStoreName = "ConstellationsRNG_v1"

-- Game pass IDs. 0 = not created yet
Config.GamePasses = {
	Luck2x = 0,
	Cash2x = 0,
}

-- Star icons: upload assets/icons/*.png to Roblox and paste the image IDs here.
-- Empty = drawn fallback circle.
Config.StarIcons = {
	dust = "137463131576979",
	spark = "98740470842740",
	dwarf = "84619811109337",
	sun = "98365759201014",
	giant = "129052977820044",
	pulsar = "114269138207453",
	neutron = "101194309009316",
	quasar = "74183692232117",
	supernova = "113026952245040",
	magnetar = "116706091240889",
	nebula = "112722285239629",
	whitehole = "101827475394899",
	galaxy = "107395453752166",
	cosmic = "117932676104830",
	bigbang = "113793732641956",
	infinity = "91772650758251",
	browndwarf = "",
	whitedwarf = "",
	redgiant = "",
	binary = "",
	wolfrayet = "",
	hypergiant = "",
	kilonova = "",
	eventhorizon = "",
	darkmatter = "",
	multiverse = "",
	cosmicweb = "",
}

-- UI icons (assets/icons/ui_*.png). Same as StarIcons: paste uploaded image IDs.
Config.UiIcons = {
	catalogue = "107402829607762",
	sky = "104272326719626",
	upgrades = "76865058340757",
	index = "93310774370747",
	constellations = "129859327315009",
	odds = "89101290443368",
	rewards = "88325511755224",
	cash = "98757200307701",
	luck = "137487992289485",
	rolls = "97966246674669",
	settings = "104579262501708",
	coins = "129002927140322", -- ui_coins.png (header cash)
	income = "128510907463165", -- ui_income.png (header per second)
	rebirth = "73756458949010", -- ui_rebirth.png
	build = "81422090060014", -- ui_build.png
}

-- Audio (assets/audio/*.ogg): upload and paste the IDs.
-- Music can hold several tracks; they play one after another.
Config.Sounds = {
	Music = { "70905224258341" },
	MusicVolume = 0.12,
	Rebirth = "73693601629586",
	GlobalRare = "", -- empty = uses the rebirth sound
	RebirthVolume = 0.8,
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Constellations</string><ProtectedString name="Source"><![CDATA[-- A constellation = an isolated group of stars (diagonal neighbors count)
-- whose shape matches a pattern (rotations and mirrors allowed).
-- An extra neighbor breaks it: that's the puzzle.
local Constellations = {}

-- All stars of the same type -> extra multiplier
Constellations.PureBonus = 1.5

Constellations.List = {
	{ id = "pair", name = "Binary Star", mult = 1.2,
		cells = { {0,0}, {1,0} } },
	{ id = "triangle", name = "Summer Triangle", mult = 1.4,
		cells = { {0,0}, {1,0}, {0,1} } },
	{ id = "belt", name = "Orion's Belt", mult = 1.5,
		cells = { {0,0}, {1,0}, {2,0} } },
	{ id = "pegasus", name = "Pegasus Square", mult = 2,
		cells = { {0,0}, {1,0}, {0,1}, {1,1} } },
	{ id = "rhombus", name = "Dolphin Diamond", mult = 2.5,
		cells = { {1,0}, {0,1}, {2,1}, {1,2} } },
	{ id = "cross", name = "Southern Cross", mult = 3,
		cells = { {1,0}, {0,1}, {1,1}, {2,1}, {1,2} } },
	{ id = "cassiopeia", name = "Cassiopeia", mult = 3.5,
		cells = { {0,0}, {1,1}, {2,0}, {3,1}, {4,0} } },
	{ id = "dipper", name = "Big Dipper", mult = 5,
		cells = { {0,0}, {1,0}, {2,0}, {3,0}, {4,0}, {3,1}, {4,1} } },
	{ id = "ring", name = "Galaxy Ring", mult = 8,
		cells = { {0,0}, {1,0}, {2,0}, {0,1}, {2,1}, {0,2}, {1,2}, {2,2} } },
}

Constellations.ById = {}
for _, pattern in Constellations.List do
	Constellations.ById[pattern.id] = pattern
end

return Constellations
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Evolution</string><ProtectedString name="Source"><![CDATA[-- Stars on the sky age and level up. Some stars at max level can explode into a better star.
local Evolution = {}

Evolution.Thresholds = { 0, 60, 300, 1200, 3600 } -- seconds on the sky
Evolution.Mults = { 1, 1.25, 1.5, 2, 3 }
Evolution.MaxLevel = #Evolution.Thresholds
Evolution.ExplodeChance = 1 / 900 -- per second, at max level

function Evolution.level(age: number): number
	local level = 1
	for i, threshold in Evolution.Thresholds do
		if age >= threshold then
			level = i
		end
	end
	return level
end

function Evolution.mult(age: number): number
	return Evolution.Mults[Evolution.level(age)]
end

return Evolution
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[local Format = {}

-- K, M, B, T, Qd (quadrillion), Qn (quintillion), Sx, Sp, Oc, No, Dc, ...
local suffixes = {
	"", "K", "M", "B", "T", "Qd", "Qn", "Sx", "Sp", "Oc", "No",
	"Dc", "Ud", "Dd", "Td", "Qdd", "Qnd", "Sxd", "Spd", "Ocd", "Nvd", "Vg",
}

function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "inf"
	end
	local negative = n < 0
	n = math.abs(n)
	local out
	if n < 1000 then
		out = tostring(math.floor(n * 10 + 0.5) / 10)
	else
		local i = 1
		while n >= 1000 and i < #suffixes do
			n /= 1000
			i += 1
		end
		if n >= 1000 then
			out = string.format("%.2e", n * 1000 ^ (i - 1))
		else
			out = string.format("%.2f", n):gsub("%.?0+$", "") .. suffixes[i]
		end
	end
	return (if negative then "-" else "") .. out
end

-- "5Qd", "1.5e12", "250K" -> number (admin input)
function Format.parse(text: string): number?
	if type(text) ~= "string" then
		return nil
	end
	text = text:gsub("%s", ""):gsub(",", "")
	local plain = tonumber(text)
	if plain then
		return plain
	end
	local num, suffix = string.match(text, "^([%d%.]+)(%a+)$")
	num = tonumber(num)
	if not num then
		return nil
	end
	for i, s in suffixes do
		if s ~= "" and string.lower(s) == string.lower(suffix) then
			return num * 1000 ^ (i - 1)
		end
	end
	return nil
end

function Format.percent(p: number): string
	if p >= 0.01 then
		return string.format("%.2f%%", p * 100)
	end
	if p >= 0.000001 then
		return (string.format("%.6f%%", p * 100):gsub("0+%%$", "%%"))
	end
	return string.format("%.1e%%", p * 100)
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Format
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[-- Item key = "starId" or "starId|mutationId"
local Stars = require(script.Parent.Stars)
local Mutations = require(script.Parent.Mutations)

local Items = {}

function Items.key(starId: string, mutationId: string?): string
	if mutationId == nil or mutationId == "normal" then
		return starId
	end
	return starId .. "|" .. mutationId
end

function Items.parse(key: any)
	if type(key) ~= "string" then
		return nil, nil
	end
	local starId, mutationId = string.match(key, "^(%w+)|(%w+)$")
	if not starId then
		starId, mutationId = key, "normal"
	end
	local star, mutation = Stars.ById[starId], Mutations.ById[mutationId]
	if not star or not mutation then
		return nil, nil
	end
	return star, mutation
end

function Items.name(key: string): string
	local star, mutation = Items.parse(key)
	if not star then
		return "?"
	end
	return if mutation.id == "normal" then star.name else mutation.name .. " " .. star.name
end

function Items.income(key: string): number
	local star, mutation = Items.parse(key)
	return if star then star.income * mutation.mult else 0
end

function Items.chance(key: string): number
	local star, mutation = Items.parse(key)
	return if star then star.chance * mutation.chance else 0
end

-- for sorting: rarer first
function Items.rank(key: string): number
	local star, mutation = Items.parse(key)
	return if star then star.index * 100 + mutation.index else 0
end

return Items
]]></ProtectedString></Properties></Item>
