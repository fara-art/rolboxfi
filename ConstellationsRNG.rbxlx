</Item>
<Item class="ServerScriptService" referent="RBX23"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX22"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX11"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Stars = require(Shared.Stars)
local Mutations = require(Shared.Mutations)
local Constellations = require(Shared.Constellations)
local Items = require(Shared.Items)
local Evolution = require(Shared.Evolution)
local Odds = require(Shared.Odds)
local Sky = require(Shared.Sky)
local Format = require(Shared.Format)
local DataService = require(script.Parent.DataService)
local World = require(script.Parent.World)
local Leaderboards = require(script.Parent.Leaderboards)

-- Remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(className: string, name: string)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local RollFn = remote("RemoteFunction", "Roll")
local ActionEv = remote("RemoteEvent", "Action")
local StateEv = remote("RemoteEvent", "State")
local AnnounceEv = remote("RemoteEvent", "Announce") -- (langKey, args, color)
local PickerEv = remote("RemoteEvent", "OpenPicker") -- (cellKey)
local OpenWindowEv = remote("RemoteEvent", "OpenWindow") -- (name)
local GlobalRareEv = remote("RemoteEvent", "GlobalRare") -- (playerName, itemKey, chance)
remotes.Parent = ReplicatedStorage

ReplicatedStorage:SetAttribute("ShowerEndsAt", 0)

World.build()

local GOLD = Color3.fromRGB(255, 196, 70)
local rng = Random.new()
local sessions: { [Player]: any } = {}

---------------------------------------------------------------- messaging
local function toast(player: Player, key: string, args: { any }?, color: Color3?)
	AnnounceEv:FireClient(player, key, args or {}, color or GOLD)
end

local function announceAll(key: string, args: { any }, color: Color3?)
	AnnounceEv:FireAllClients(key, args, color or GOLD)
end

---------------------------------------------------------------- helpers
local function checkPass(player: Player, name: string): boolean
	local id = Config.GamePasses[name]
	if not id or id == 0 then
		return false
	end
	local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
	return ok and owns == true
end

local function refreshPasses(player: Player)
	local session = sessions[player]
	if session then
		for name in Config.GamePasses do
			session.passes[name] = checkPass(player, name)
		end
	end
end

local function isShower(): boolean
	return workspace:GetServerTimeNow() < (ReplicatedStorage:GetAttribute("ShowerEndsAt") or 0)
end

local function getLuck(player: Player, data): number
	local luck = (1 + data.luckLevel * Config.LuckPerLevel + data.bonusLuck) * (1 + data.rebirths * Config.RebirthLuckMult)
	if sessions[player].passes.Luck2x then
		luck *= 2
	end
	if isShower() then
		luck *= Config.ShowerLuck
	end
	return luck
end

local function incomePerSecond(player: Player, data): number
	local session = sessions[player]
	if not World.plotOf(player) or not session.eval then
		return 0
	end
	local mult = (1 + data.rebirths * Config.RebirthIncomeBonus) * (if session.passes.Cash2x then 2 else 1)
	return session.eval.income * mult
end

local function recompute(player: Player, data)
	local session = sessions[player]
	session.eval = Sky.evaluate(data.grid, data.gridSize, data.slabs)
	if World.plotOf(player) then
		for _, group in session.eval.groups do
			if not data.discovered[group.id] then
				data.discovered[group.id] = true
				announceAll("annDiscover", { player.DisplayName, { constellation = group.id }, Constellations.ById[group.id].mult })
			end
		end
		World.renderPlot(player, data, session.eval, incomePerSecond(player, data))
	end
end

local function setStat(player: Player, name: string, value: number)
	local stats = player:FindFirstChild("leaderstats")
	local stat = stats and stats:FindFirstChild(name)
	if stat then
		stat.Value = value
	end
end

local function setCash(player: Player, data, value: number)
	data.cash = value
	setStat(player, "Cash", value)
end

-- Admin = owner of the game (user-owned games), listed user IDs, or anyone in a Studio test
local function isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(Config.AdminUserIds, player.UserId) ~= nil
end

local function pushState(player: Player)
	local session = sessions[player]
	local data = DataService.get(player)
	if not session or not data then
		return
	end
	StateEv:FireClient(player, {
		cash = data.cash,
		inventory = data.inventory,
		grid = data.grid,
		gridSize = data.gridSize,
		luckLevel = data.luckLevel,
		rollSpeedLevel = data.rollSpeedLevel,
		multiRollLevel = data.multiRollLevel,
		luck = getLuck(player, data),
		income = incomePerSecond(player, data),
		groups = if session.eval then session.eval.groups else {},
		discovered = data.discovered,
		totalRolls = data.totalRolls,
		rebirthRolls = data.rebirthRolls,
		rebirths = data.rebirths,
		mass = data.mass,
		index = data.index,
		indexClaims = data.indexClaims,
		milestones = data.milestones,
		lang = data.lang,
		settings = data.settings,
		hasPlot = World.plotOf(player) ~= nil,
		passes = session.passes,
		isAdmin = isAdmin(player),
	})
end

local function takeFromInventory(data, key: string, count: number): boolean
	local have = data.inventory[key] or 0
	if count < 1 or have < count then
		return false
	end
	have -= count
	data.inventory[key] = if have > 0 then have else nil
	return true
end

local function discover(player: Player, data, key: string)
	if Items.chance(key) > Items.chance(data.best) then
		data.best = key
	end
	if not data.index[key] then
		data.index[key] = true
		toast(player, "toastNewIndex", { { item = key } }, Items.parse(key).color)
	end
end

-- free starter slabs in the middle of the plot (and under stars from older saves)
local function giveFreeSlabs(data)
	if data.freeSlabsGiven then
		return
	end
	data.freeSlabsGiven = true
	for key in data.grid do
		data.slabs[key] = data.slabs[key] or "stone"
	end
	local c = math.floor(data.gridSize / 2)
	local given = 0
	for _, offset in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local key = Sky.key(c + offset[1], c + offset[2])
		if given < Config.FreeStoneSlabs and not data.slabs[key] then
			data.slabs[key] = "stone"
			given += 1
		end
	end
end

local function addToInventory(player: Player, data, key: string, count: number)
	data.inventory[key] = (data.inventory[key] or 0) + count
	discover(player, data, key)
end

-- integer in [0, max], rejects NaN / junk from the client
local function toCount(value: any, max: number): number
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, max)
end

local function inBounds(data, key: any): boolean
	local x, y = Sky.parse(key)
	return x ~= nil and y ~= nil and x >= 1 and y >= 1 and x <= data.gridSize and y <= data.gridSize
end

local function rollItem(luck: number): string
	return Odds.roll(luck, rng).id -- mutations come from upgrading at the Forge
end

local function announceIfRare(player: Player, key: string)
	local chance = Items.chance(key)
	if chance >= Config.GlobalRareChance then
		-- whole server sees a cinematic + a pillar of light over the lucky player
		GlobalRareEv:FireAllClients(player.DisplayName, key, chance)
		World.lightPillar(player, Items.parse(key).color)
	elseif chance >= Config.AnnounceChance then
		announceAll("annRolled", { player.DisplayName, { item = key }, Format.number(chance), chance }, Items.parse(key).color)
	end
end



local function spend(player: Player, data, cost: number): boolean
	if data.cash < cost then
		toast(player, "toastNeedCash", { Format.number(cost) })
		return false
	end
	setCash(player, data, data.cash - cost)
	return true
end

---------------------------------------------------------------- join / leave
local function onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	if character.Parent then
		character:PivotTo(World.spawnCFrame(player))
	end
end

Players.PlayerAdded:Connect(function(player)
	local data = DataService.load(player)
	if not data then
		return
	end
	sessions[player] = { lastRoll = 0, passes = {}, eval = nil }
	refreshPasses(player)

	-- older saves: put everything owned into the Index
	for key in data.inventory do
		data.index[key] = true
	end
	for _, cell in data.grid do
		data.index[cell.id] = true
	end
	for key in data.index do
		if Items.chance(key) > Items.chance(data.best) then
			data.best = key
		end
	end
	giveFreeSlabs(data)
	if data.rebirthRolls < 0 then
		data.rebirthRolls = data.totalRolls
	end
	data.settings.rareAlert = data.settings.rareAlert or 50000000

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, info in { { "Cash", "NumberValue", data.cash }, { "Rolls", "IntValue", data.totalRolls }, { "Rebirths", "IntValue", data.rebirths } } do
		local value = Instance.new(info[2])
		value.Name = info[1]
		value.Value = info[3]
		value.Parent = stats
	end
	stats.Parent = player

	recompute(player, data)
	pushState(player)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local leaving = DataService.get(player)
	if leaving then
		task.spawn(Leaderboards.submit, player, leaving)
	end
	World.releasePlot(player)
	DataService.release(player)
	sessions[player] = nil
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, _, purchased)
	local data = DataService.get(player)
	if purchased and sessions[player] and data then
		refreshPasses(player)
		recompute(player, data)
		pushState(player)
	end
end)

---------------------------------------------------------------- plots
World.onPlotTouched = function(player, index)
	local data = DataService.get(player)
	if not data or not sessions[player] or World.plotOf(player) then
		return
	end
	if World.claimPlot(player, index) then
		toast(player, "toastClaimed", {}, Color3.fromRGB(90, 200, 140))
		recompute(player, data)
		pushState(player)
	end
end

World.onForge = function(player)
	OpenWindowEv:FireClient(player, "forge")
end

World.onHole = function(player)
	OpenWindowEv:FireClient(player, "hole")
end

World.onPedestal = function(player, index, cellKey)
	local data = DataService.get(player)
	if not data or not sessions[player] then
		return
	end
	if World.plotOf(player) ~= index then
		return toast(player, "toastNotYours")
	end
	local placed = data.grid[cellKey]
	if placed then
		data.grid[cellKey] = nil
		addToInventory(player, data, placed.id, 1)
		recompute(player, data)
		pushState(player)
	else
		PickerEv:FireClient(player, cellKey)
	end
end

---------------------------------------------------------------- roll
RollFn.OnServerInvoke = function(player)
	local session = sessions[player]
	local data = DataService.get(player)
	if not session or not data then
		return nil
	end
	local now = os.clock()
	if now - session.lastRoll < Config.RollCooldown(data.rollSpeedLevel) * 0.9 then
		return nil
	end
	session.lastRoll = now

	local before = data.totalRolls
	local luck = getLuck(player, data)
	local results = {}
	for i = 1, 1 + data.multiRollLevel do
		local key = rollItem(luck)
		results[i] = key
		addToInventory(player, data, key, 1)
		announceIfRare(player, key)
	end
	data.totalRolls += #results
	data.rebirthRolls += #results
	setStat(player, "Rolls", data.totalRolls)
	if before < Config.AutoRollUnlock and data.totalRolls >= Config.AutoRollUnlock then
		toast(player, "toastAutoUnlocked", {}, Color3.fromRGB(90, 200, 140))
	end
	pushState(player)
	return results
end

---------------------------------------------------------------- actions
local actions = {}

function actions.Place(player, data, cellKey, itemKey)
	local index = World.plotOf(player)
	if not index or not inBounds(data, cellKey) or not Items.parse(itemKey) then
		return
	end
	if not World.isNearPlot(player, index) then
		return toast(player, "toastTooFar")
	end
	if not data.slabs[cellKey] then
		return toast(player, "needSlab")
	end
	if not takeFromInventory(data, itemKey, 1) then
		return
	end
	local old = data.grid[cellKey]
	if old then
		addToInventory(player, data, old.id, 1)
	end
	data.grid[cellKey] = { id = itemKey, age = 0 }
	recompute(player, data)
end

function actions.Sell(player, data, itemKey, count)
	if not Items.parse(itemKey) then
		return
	end
	count = toCount(count, data.inventory[itemKey] or 0)
	if takeFromInventory(data, itemKey, count) then
		setCash(player, data, data.cash + Items.income(itemKey) * Config.SellMultiplier * count)
	end
end

function actions.Forge(player, data, itemKey)
	local star, mutation = Items.parse(itemKey)
	if not star then
		return
	end
	if World.distanceTo(player, World.ForgePosition) > Config.ForgeReach then
		return toast(player, "toastTooFar")
	end
	local nextStar = Stars.List[star.index + 1]
	if not nextStar then
		return
	end
	if (data.inventory[itemKey] or 0) < Config.ForgeAmount then
		return toast(player, "toastNeedSame", { Config.ForgeAmount })
	end
	if not spend(player, data, nextStar.income * Config.ForgeCostMult) then
		return
	end
	takeFromInventory(data, itemKey, Config.ForgeAmount)
	local result = Items.key(nextStar.id, mutation.id)
	addToInventory(player, data, result, 1)
	toast(player, "toastForged", { { item = result } }, nextStar.color)
	if Items.chance(result) >= Config.AnnounceChance then
		announceAll("annForged", { player.DisplayName, { item = result } }, nextStar.color)
	end
end

-- Forge upgrade: N copies of a star -> 1 copy with the next mutation
function actions.UpgradeMutation(player, data, itemKey)
	local star, mutation = Items.parse(itemKey)
	if not star then
		return
	end
	if World.distanceTo(player, World.ForgePosition) > Config.ForgeReach then
		return toast(player, "toastTooFar")
	end
	local nextMutation = Mutations.List[mutation.index + 1]
	if not nextMutation then
		return
	end
	if (data.inventory[itemKey] or 0) < nextMutation.copies then
		return toast(player, "toastNeedSame", { nextMutation.copies })
	end
	local result = Items.key(star.id, nextMutation.id)
	if not spend(player, data, Items.income(result) * Config.ForgeCostMult) then
		return
	end
	takeFromInventory(data, itemKey, nextMutation.copies)
	addToInventory(player, data, result, 1)
	toast(player, "toastForged", { { item = result } }, nextMutation.color)
end

function actions.Feed(player, data, itemKey, count)
	if not Items.parse(itemKey) then
		return
	end
	if World.distanceTo(player, World.AltarPosition) > Config.AltarReach then
		return toast(player, "toastTooFar")
	end
	count = toCount(count, data.inventory[itemKey] or 0)
	if takeFromInventory(data, itemKey, count) then
		data.mass += Items.income(itemKey) * Config.SellMultiplier * count
	end
end

function actions.Rebirth(player, data)
	if World.distanceTo(player, World.AltarPosition) > Config.AltarReach then
		return toast(player, "toastTooFar")
	end
	if data.mass < Config.RebirthCost(data.rebirths) then
		return
	end
	data.rebirths += 1
	data.mass = 0
	data.inventory = {}
	data.grid = {}
	data.gridSize = Config.StartGridSize
	data.luckLevel = 0
	data.rollSpeedLevel = 0
	data.multiRollLevel = 0
	data.slabs = {}
	data.freeSlabsGiven = false
	giveFreeSlabs(data)
	data.rebirthRolls = 0 -- roll rewards start over every rebirth
	data.milestones = {}
	setCash(player, data, 0)
	setStat(player, "Rebirths", data.rebirths)
	recompute(player, data)
	announceAll("annRebirth", { player.DisplayName, data.rebirths }, Color3.fromRGB(176, 110, 255))
end

function actions.BuyLuck(player, data)
	if data.luckLevel < Config.MaxLuckLevel and spend(player, data, Config.LuckCost(data.luckLevel)) then
		data.luckLevel += 1
	end
end

function actions.BuySpeed(player, data)
	if data.rollSpeedLevel < Config.MaxRollSpeedLevel and spend(player, data, Config.RollSpeedCost(data.rollSpeedLevel)) then
		data.rollSpeedLevel += 1
	end
end

function actions.BuyMulti(player, data)
	if data.multiRollLevel < Config.MaxMultiRollLevel and spend(player, data, Config.MultiRollCost(data.multiRollLevel)) then
		data.multiRollLevel += 1
	end
end

function actions.BuyGrid(player, data)
	if data.gridSize < Config.MaxGridSize and spend(player, data, Config.GridCost(data.gridSize)) then
		data.gridSize += 1
		recompute(player, data)
	end
end

function actions.ClaimIndexRow(player, data, mutationId, tierNumber)
	local mutation = type(mutationId) == "string" and Mutations.ById[mutationId]
	local tier = type(tierNumber) == "number" and Config.IndexTiers[tierNumber]
	local claimKey = tostring(tierNumber) .. ":" .. tostring(mutationId)
	if not mutation or not tier or data.indexClaims[claimKey] then
		return
	end
	for i = tier.first, tier.last do
		local star = Stars.List[i]
		if star and not data.index[Items.key(star.id, mutationId)] then
			return
		end
	end
	data.indexClaims[claimKey] = true
	data.bonusLuck += tier.luck * (Config.IndexMutationMult[mutationId] or 1)
end

function actions.ClaimMilestone(player, data, number)
	local milestone = type(number) == "number" and Config.RollMilestones[number]
	local id = tostring(number)
	if not milestone or data.milestones[id] or data.rebirthRolls < milestone.rolls then
		return
	end
	data.milestones[id] = true
	if milestone.cash then
		setCash(player, data, data.cash + milestone.cash)
	end
	if milestone.luck then
		data.bonusLuck += milestone.luck
	end
	if milestone.item and Items.parse(milestone.item) then
		addToInventory(player, data, milestone.item, milestone.count or 1)
		toast(player, "toastReward", { { item = milestone.item } }, Items.parse(milestone.item).color)
	end
end

function actions.SetSetting(player, data, name, value)
	if (name == "music" or name == "sfx") and type(value) == "boolean" then
		data.settings[name] = value
	elseif name == "rareAlert" and type(value) == "number" and value == value and value >= 0 and value <= 1e15 then
		data.settings.rareAlert = value
	end
end

---------------------------------------------------------------- build mode: slabs
function actions.BuildSlab(player, data, cellKey, slabId)
	local index = World.plotOf(player)
	local slab = type(slabId) == "string" and Config.SlabsById[slabId]
	if not index or not slab or not inBounds(data, cellKey) then
		return
	end
	if not World.isNearPlot(player, index) then
		return toast(player, "toastTooFar")
	end
	if data.slabs[cellKey] == slab.id then
		return
	end
	if spend(player, data, slab.cost) then
		data.slabs[cellKey] = slab.id
		recompute(player, data)
	end
end

function actions.RemoveSlab(player, data, cellKey)
	local index = World.plotOf(player)
	local slab = type(cellKey) == "string" and Config.SlabsById[data.slabs[cellKey]]
	if not index or not slab then
		return
	end
	if not World.isNearPlot(player, index) then
		return toast(player, "toastTooFar")
	end
	local placed = data.grid[cellKey]
	if placed then
		data.grid[cellKey] = nil
		addToInventory(player, data, placed.id, 1)
	end
	data.slabs[cellKey] = nil
	setCash(player, data, data.cash + math.floor(slab.cost * Config.SlabRefund))
	recompute(player, data)
end

---------------------------------------------------------------- admin (checked on the server, see the handler below)
local function adminNumber(value: any): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value < 0 then
		return nil
	end
	return math.min(value, 1e300)
end

function actions.AdminCash(player, data, amount)
	amount = adminNumber(amount)
	if amount then
		setCash(player, data, data.cash + amount)
	end
end

function actions.AdminStar(player, data, itemKey, count)
	count = adminNumber(count)
	if Items.parse(itemKey) and count and count >= 1 then
		addToInventory(player, data, itemKey, math.floor(math.min(count, 1e6)))
	end
end

function actions.AdminRolls(player, data, amount)
	amount = adminNumber(amount)
	if amount then
		data.totalRolls += math.floor(math.min(amount, 1e9))
		data.rebirthRolls += math.floor(math.min(amount, 1e9))
		setStat(player, "Rolls", data.totalRolls)
	end
end

function actions.AdminMass(player, data, amount)
	amount = adminNumber(amount)
	if amount then
		data.mass += amount
	end
end

local startShower -- defined at the bottom
function actions.AdminShower(player, data)
	if startShower then
		task.spawn(startShower)
	end
end

function actions.AdminGlobalTest(player, data, itemKey)
	local key = if Items.parse(itemKey) then itemKey else "infinity|celestial"
	GlobalRareEv:FireAllClients(player.DisplayName, key, Items.chance(key))
	World.lightPillar(player, Items.parse(key).color)
end

function actions.SetLang(player, data, lang)
	if lang == "en" or lang == "ru" then
		data.lang = lang
	end
end

ActionEv.OnServerEvent:Connect(function(player, action, a, b)
	local handler = type(action) == "string" and actions[action]
	local data = DataService.get(player)
	if not handler or not data or not sessions[player] then
		return
	end
	if string.sub(action, 1, 5) == "Admin" and not isAdmin(player) then
		warn("[Admin] blocked " .. action .. " from " .. player.Name)
		return
	end
	handler(player, data, a, b)
	pushState(player)
end)

---------------------------------------------------------------- every second: income and aging
local function tickPlayer(player: Player, session)
	local data = DataService.get(player)
	if not data or not session.eval or not World.plotOf(player) then
		return
	end

	local changed = false
	for _, cell in data.grid do
		local before = Evolution.level(cell.age)
		cell.age += 1
		local after = Evolution.level(cell.age)
		if after ~= before then
			changed = true
		end
		if after == Evolution.MaxLevel then
			local star, mutation = Items.parse(cell.id)
			if star and star.evolvesTo and rng:NextNumber() < Evolution.ExplodeChance then
				local oldKey = cell.id
				cell.id = Items.key(star.evolvesTo, mutation.id)
				cell.age = 0
				changed = true
				discover(player, data, cell.id)
				announceAll("annExploded", { player.DisplayName, { item = oldKey }, { item = cell.id } }, Stars.ById[star.evolvesTo].color)
			end
		end
	end
	if changed then
		recompute(player, data)
		pushState(player)
	end

	setCash(player, data, data.cash + incomePerSecond(player, data))
end

task.spawn(function()
	while true do
		task.wait(1)
		for player, session in sessions do
			task.spawn(tickPlayer, player, session)
		end
	end
end)

---------------------------------------------------------------- falling off the world: back to base, no death
task.spawn(function()
	while true do
		task.wait(0.25)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root.Position.Y < -40 then
				root.AssemblyLinearVelocity = Vector3.zero
				character:PivotTo(World.spawnCFrame(player))
			end
		end
	end
end)

---------------------------------------------------------------- Star Shower
startShower = function()
	ReplicatedStorage:SetAttribute("ShowerEndsAt", workspace:GetServerTimeNow() + Config.ShowerDuration)
	announceAll("annShower", { Config.ShowerLuck, Format.time(Config.ShowerDuration) }, Color3.fromRGB(90, 170, 255))
	for player in sessions do
		pushState(player)
	end
	task.wait(Config.ShowerDuration)
	for player in sessions do
		pushState(player)
	end
end

task.spawn(function()
	while true do
		task.wait(Config.ShowerInterval)
		startShower()
	end
end)

---------------------------------------------------------------- Leaderboards: submit + refresh every 2 minutes
local function liveRows()
	local rows = {}
	for player in sessions do
		local data = DataService.get(player)
		if data then
			table.insert(rows, { player = player, data = data })
		end
	end
	return rows
end

task.spawn(function()
	task.wait(8)
	Leaderboards.refresh(liveRows())
	while true do
		task.wait(120)
		for _, row in liveRows() do
			Leaderboards.submit(row.player, row.data)
		end
		Leaderboards.refresh(liveRows())
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Player progress saving (DataStore)
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local cache: { [Player]: any } = {}

local function default()
	return {
		cash = 0,
		inventory = {}, -- [itemKey] = count
		grid = {}, -- ["x_y"] = { id = itemKey, age = seconds }
		gridSize = Config.StartGridSize,
		luckLevel = 0,
		discovered = {}, -- [constellationId] = true
		totalRolls = 0,
		rebirths = 0,
		mass = 0, -- Black Hole progress
		rollSpeedLevel = 0,
		multiRollLevel = 0,
		bonusLuck = 0, -- from Index rows and roll milestones, survives rebirth
		index = {}, -- [itemKey] = true, every star ever found
		indexClaims = {}, -- [mutationId] = true
		milestones = {}, -- ["1"] = true (string keys for DataStore)
		lang = "", -- "" = auto
		settings = { music = true, sfx = true, rareAlert = 50000000 },
		slabs = {}, -- ["x_y"] = slab id (build mode)
		freeSlabsGiven = false,
		best = "", -- rarest item ever found (leaderboard)
		rebirthRolls = -1, -- rolls since the last rebirth (roll rewards); -1 = not migrated yet
	}
end

local function reconcile(data)
	for key, value in default() do
		if data[key] == nil then
			data[key] = value
		end
	end
	-- v1 saves stored grid cells as plain star ids
	for key, cell in data.grid do
		if type(cell) == "string" then
			data.grid[key] = { id = cell, age = 0 }
		end
	end
	return data
end

local function retry(fn)
	for attempt = 1, 3 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn("[DataService] attempt", attempt, result)
		task.wait(attempt)
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "p_" .. player.UserId
end

function DataService.load(player: Player)
	local ok, data = false, nil
	if store then
		ok, data = retry(function()
			return store:GetAsync(keyFor(player))
		end)
	end
	if not ok then
		if RunService:IsStudio() then
			warn("[DataService] DataStore unavailable (enable API Services in Game Settings). Playing without saves.")
		else
			player:Kick("Failed to load your data. Please rejoin.")
			return nil
		end
	end
	data = reconcile(if type(data) == "table" then data else default())
	cache[player] = data
	return data
end

function DataService.get(player: Player)
	return cache[player]
end

function DataService.save(player: Player)
	local data = cache[player]
	if not data or not store then
		return
	end
	retry(function()
		store:SetAsync(keyFor(player), data)
	end)
end

function DataService.release(player: Player)
	DataService.save(player)
	cache[player] = nil
end

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for player in cache do
			task.spawn(DataService.save, player)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			DataService.save(player)
			pending -= 1
		end)
	end
	while pending > 0 do
		task.wait()
	end
end)

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Leaderboards</string><ProtectedString name="Source"><![CDATA[-- Global top-100 boards (rolls, rebirths, cash, rarest find) in OrderedDataStores.
-- Results go to ReplicatedStorage.Leaderboards.<board> as JSON for the clients to draw.
-- Falls back to the players on this server when DataStores are unavailable (e.g. Studio without API access).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Stars = require(Shared.Stars)
local Mutations = require(Shared.Mutations)
local Items = require(Shared.Items)

local Leaderboards = {}

local BOARDS = { "rolls", "rebirths", "cash", "rarest" }
local TOP = 100

local stores = {}
pcall(function()
	for _, board in BOARDS do
		stores[board] = DataStoreService:GetOrderedDataStore("LB_" .. board .. "_v2")
	end
end)

local folder = Instance.new("Folder")
folder.Name = "Leaderboards"
local values = {}
for _, board in BOARDS do
	local v = Instance.new("StringValue")
	v.Name = board
	v.Value = "[]"
	v.Parent = folder
	values[board] = v
end
folder.Parent = ReplicatedStorage

-- OrderedDataStore only keeps integers, so cash is stored as log10 and the rarest find as a sortable code
local function encode(board: string, data): number?
	if board == "rolls" then
		return math.floor(data.totalRolls)
	elseif board == "rebirths" then
		return math.floor(data.rebirths)
	elseif board == "cash" then
		return math.floor(math.log10(math.max(data.cash, 0) + 1) * 1e9)
	elseif board == "rarest" then
		local star, mutation = Items.parse(data.best)
		if not star then
			return nil
		end
		return math.floor(math.log10(Items.chance(data.best)) * 1000) * 10000 + star.index * 100 + mutation.index
	end
	return nil
end

local function decode(board: string, value: number)
	if board == "cash" then
		return 10 ^ (value / 1e9) - 1
	elseif board == "rarest" then
		local star = Stars.List[math.floor(value / 100) % 100]
		local mutation = Mutations.List[value % 100]
		return if star and mutation then Items.key(star.id, mutation.id) else nil
	end
	return value
end

local names = {}
local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		names[userId] = online.Name
		return online.Name
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok and name then name else ("#" .. userId)
	return names[userId]
end

function Leaderboards.submit(player: Player, data)
	for _, board in BOARDS do
		local store = stores[board]
		local value = encode(board, data)
		if store and value and value > 0 then
			pcall(store.SetAsync, store, tostring(player.UserId), value)
		end
	end
end

-- live: { { player, data } } of this server, used when the global store can't be read
function Leaderboards.refresh(live)
	for _, board in BOARDS do
		local list = nil
		local store = stores[board]
		if store then
			local ok, pages = pcall(store.GetSortedAsync, store, false, TOP)
			if ok and pages then
				list = {}
				for _, entry in pages:GetCurrentPage() do
					local userId = tonumber(entry.key)
					local value = decode(board, entry.value)
					if userId and value then
						table.insert(list, { name = nameOf(userId), value = value })
					end
				end
			end
		end
		if not list then
			list = {}
			for _, row in live do
				local value = encode(board, row.data)
				if value and value > 0 then
					table.insert(list, { name = row.player.Name, value = decode(board, value), sort = value })
				end
			end
			table.sort(list, function(a, b)
				return a.sort > b.sort
			end)
			for _, row in list do
				row.sort = nil
			end
		end
		values[board].Value = HttpService:JSONEncode(list)
	end
end

return Leaderboards
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">StarModels</string><ProtectedString name="Source"><![CDATA[-- 3D star models that sit on plot pedestals. Each star type has its own look,
-- glow shell and particles. The client spins / bobs models tagged "StarModel".
local CollectionService = game:GetService("CollectionService")

local StarModels = {}

local function part(model: Model, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" then
			p[key] = value
		end
	end
	p.Parent = model
	return p
end

local function orb(model: Model, cf: CFrame, diameter: number, color: Color3, transparency: number?)
	if transparency and transparency > 0 then
		transparency = 1 - (1 - transparency) * 0.45 -- glow shells are much fainter
	end
	return part(model, {
		Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * diameter, CFrame = cf,
		Material = Enum.Material.Neon, Color = color, Transparency = transparency or 0,
	})
end

local function bar(model: Model, cf: CFrame, size: Vector3, color: Color3, transparency: number?)
	return part(model, { Name = "Bar", Size = size, CFrame = cf, Material = Enum.Material.Neon, Color = color, Transparency = transparency or 0 })
end

local function disk(model: Model, cf: CFrame, diameter: number, color: Color3, transparency: number)
	return part(model, {
		Name = "Disk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, diameter, diameter),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Neon, Color = color, Transparency = transparency,
	})
end

local function particles(parent: BasePart, props)
	local e = Instance.new("ParticleEmitter")
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = (props.Rate or 8) * 1.8
	e.Lifetime = props.Lifetime or NumberRange.new(1.2, 2.4)
	e.Speed = props.Speed or NumberRange.new(0.6, 1.6)
	e.SpreadAngle = props.Spread or Vector2.new(180, 180)
	e.Acceleration = props.Acceleration or Vector3.new(0, 0.8, 0)
	e.Drag = props.Drag or 1
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Rotation = NumberRange.new(0, 360)
	e.Color = ColorSequence.new(props.Color, props.Color2 or props.Color)
	e.Size = props.Size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.22), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	if props.Texture then
		e.Texture = props.Texture
	end
	e.Parent = parent
	return e
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range * 0.8
	l.Brightness = brightness * 0.4
	l.Shadows = false
	l.Parent = parent
end

local KIND_BUILDERS -- filled in below
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local WHITE = Color3.new(1, 1, 1)

-- builders: (model, cf, color) -> core part
local builders = {}

builders.dust = function(m, cf, color)
	local core = orb(m, cf, 0.5, WHITE)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		orb(m, cf * CFrame.new(math.cos(a) * 0.8, math.sin(i * 1.7) * 0.4, math.sin(a) * 0.8), 0.25 + (i % 3) * 0.08, color)
	end
	orb(m, cf, 2.2, color, 0.88)
	particles(core, { Color = color, Rate = 6, Texture = SPARKLE })
	return core
end

builders.spark = function(m, cf, color)
	local core = orb(m, cf, 0.6, WHITE)
	bar(m, cf, Vector3.new(0.18, 2.6, 0.18), color)
	bar(m, cf, Vector3.new(2.6, 0.18, 0.18), color)
	bar(m, cf * CFrame.Angles(0, 0, math.rad(45)), Vector3.new(0.12, 1.4, 0.12), WHITE, 0.3)
	bar(m, cf * CFrame.Angles(0, 0, math.rad(-45)), Vector3.new(0.12, 1.4, 0.12), WHITE, 0.3)
	orb(m, cf, 1.8, color, 0.85)
	particles(core, { Color = color, Color2 = WHITE, Rate = 8, Texture = SPARKLE })
	light(core, color, 6, 0.8)
	return core
end

builders.dwarf = function(m, cf, color)
	local core = orb(m, cf, 1.3, color)
	orb(m, cf, 1.9, Color3.fromRGB(255, 140, 90), 0.75)
	orb(m, cf, 2.6, color, 0.9)
	particles(core, { Color = Color3.fromRGB(255, 170, 90), Color2 = color, Rate = 10, Acceleration = Vector3.new(0, 2, 0) })
	light(core, color, 8, 1)
	return core
end

builders.sun = function(m, cf, color)
	local core = orb(m, cf, 1.6, Color3.fromRGB(255, 236, 150))
	orb(m, cf, 2.2, color, 0.6)
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		bar(m, cf * CFrame.Angles(0, 0, a) * CFrame.new(0, 1.55, 0), Vector3.new(0.25, 0.9, 0.25), Color3.fromRGB(255, 200, 70), 0.1)
	end
	orb(m, cf, 3.4, color, 0.9)
	particles(core, { Color = Color3.fromRGB(255, 220, 110), Color2 = Color3.fromRGB(255, 140, 40), Rate = 14, Acceleration = Vector3.new(0, 1.5, 0) })
	light(core, color, 12, 1.5)
	return core
end

builders.giant = function(m, cf, color)
	local core = orb(m, cf, 2.2, color)
	orb(m, cf * CFrame.new(-0.35, 0.4, -0.35), 1, Color3.fromRGB(210, 240, 255), 0.2)
	orb(m, cf, 3, Color3.fromRGB(150, 210, 255), 0.75)
	orb(m, cf, 4, color, 0.9)
	particles(core, { Color = Color3.fromRGB(170, 220, 255), Color2 = color, Rate = 16, Texture = SPARKLE })
	light(core, color, 14, 2)
	return core
end

builders.pulsar = function(m, cf, color)
	local core = orb(m, cf, 1.1, Color3.fromRGB(240, 220, 255))
	orb(m, cf, 1.8, color, 0.55)
	local tilt = cf * CFrame.Angles(0, 0, math.rad(18))
	bar(m, tilt, Vector3.new(0.2, 6, 0.2), WHITE, 0.15)
	bar(m, tilt, Vector3.new(0.6, 5.4, 0.6), color, 0.6)
	disk(m, tilt, 2.8, color, 0.7)
	particles(core, { Color = color, Color2 = WHITE, Rate = 20, Speed = NumberRange.new(2, 4), Spread = Vector2.new(10, 10), Acceleration = Vector3.zero })
	light(core, color, 14, 2)
	return core
end

builders.neutron = function(m, cf, color)
	local core = orb(m, cf, 0.8, WHITE)
	orb(m, cf, 1.4, color, 0.5)
	disk(m, cf * CFrame.Angles(math.rad(30), 0, 0), 3.2, color, 0.75)
	disk(m, cf * CFrame.Angles(math.rad(-30), 0, math.rad(60)), 3.2, color, 0.75)
	disk(m, cf * CFrame.Angles(0, 0, math.rad(90)), 3.2, Color3.fromRGB(200, 255, 245), 0.8)
	orb(m, cf, 4, color, 0.92)
	particles(core, { Color = color, Color2 = WHITE, Rate = 22, Texture = SPARKLE, Speed = NumberRange.new(1, 2.5) })
	light(core, color, 16, 2.5)
	return core
end

builders.quasar = function(m, cf, color)
	local core = orb(m, cf, 0.9, WHITE)
	local tilt = cf * CFrame.Angles(math.rad(20), 0, math.rad(10))
	disk(m, tilt, 4.4, color, 0.45)
	disk(m, tilt, 3, Color3.fromRGB(255, 170, 120), 0.35)
	disk(m, tilt, 1.8, Color3.fromRGB(255, 240, 210), 0.2)
	bar(m, tilt, Vector3.new(0.18, 8, 0.18), Color3.fromRGB(255, 210, 250), 0.2)
	bar(m, tilt, Vector3.new(0.5, 7, 0.5), color, 0.7)
	particles(core, { Color = color, Color2 = Color3.fromRGB(255, 200, 140), Rate = 30, Speed = NumberRange.new(1.5, 3), Texture = SPARKLE })
	light(core, color, 18, 3)
	return core
end

builders.supernova = function(m, cf, color)
	local core = orb(m, cf, 1.6, WHITE)
	orb(m, cf, 2.4, Color3.fromRGB(255, 230, 160), 0.4)
	for i = 1, 14 do
		local rot = CFrame.Angles(i * 1.3, i * 2.1, i * 0.7)
		local length = 2.2 + (i % 3) * 0.6
		bar(m, cf * rot * CFrame.new(0, length / 2, 0), Vector3.new(0.22, length, 0.22), if i % 2 == 0 then Color3.fromRGB(255, 190, 90) else WHITE, 0.1)
	end
	orb(m, cf, 5, Color3.fromRGB(255, 200, 120), 0.9)
	particles(core, { Color = Color3.fromRGB(255, 240, 200), Color2 = Color3.fromRGB(255, 120, 60), Rate = 45, Speed = NumberRange.new(2, 5), Texture = SPARKLE })
	particles(core, { Color = WHITE, Rate = 8, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 4) }) })
	light(core, Color3.fromRGB(255, 230, 180), 22, 4)
	return core
end

builders.magnetar = function(m, cf, color)
	local core = orb(m, cf, 1.3, Color3.fromRGB(210, 240, 255))
	orb(m, cf, 2, color, 0.55)
	for i = 1, 6 do
		-- jagged "field lines"
		local rot = CFrame.Angles(0, i * math.pi / 3, math.rad(35))
		bar(m, cf * rot * CFrame.new(0, 1.6, 0), Vector3.new(0.14, 1.3, 0.14), Color3.fromRGB(255, 240, 150), 0.1)
		bar(m, cf * rot * CFrame.new(0.25, 2.4, 0) * CFrame.Angles(0, 0, math.rad(-40)), Vector3.new(0.14, 0.9, 0.14), Color3.fromRGB(255, 240, 150), 0.1)
	end
	orb(m, cf, 4.2, color, 0.9)
	particles(core, { Color = Color3.fromRGB(255, 245, 170), Color2 = color, Rate = 30, Speed = NumberRange.new(3, 6), Lifetime = NumberRange.new(0.3, 0.7), Texture = SPARKLE })
	light(core, color, 18, 3)
	return core
end

builders.nebula = function(m, cf, color)
	local core = orb(m, cf, 1, Color3.fromRGB(255, 250, 220))
	local tints = { color, Color3.fromRGB(180, 120, 255), Color3.fromRGB(120, 200, 255) }
	for i = 1, 9 do
		local a = i * 2.4
		orb(m, cf * CFrame.new(math.cos(a) * 1.3, math.sin(i * 1.7) * 0.8, math.sin(a) * 1.3), 1.4 + (i % 3) * 0.4, tints[i % 3 + 1], 0.55)
	end
	particles(core, { Color = color, Color2 = Color3.fromRGB(150, 200, 255), Rate = 35, Speed = NumberRange.new(0.3, 1), Lifetime = NumberRange.new(2, 4), Texture = SPARKLE })
	light(core, color, 18, 2.5)
	return core
end

builders.whitehole = function(m, cf, color)
	local core = orb(m, cf, 1.8, WHITE)
	orb(m, cf, 2.6, Color3.fromRGB(220, 240, 255), 0.4)
	disk(m, cf * CFrame.Angles(math.rad(15), 0, 0), 5, Color3.fromRGB(200, 230, 255), 0.5)
	for i = 1, 12 do
		bar(m, cf * CFrame.Angles(0, 0, i * math.pi / 6) * CFrame.new(0, 2, 0), Vector3.new(0.2, 1.2, 0.2), WHITE, 0.2)
	end
	orb(m, cf, 5, color, 0.88)
	particles(core, { Color = WHITE, Color2 = Color3.fromRGB(180, 220, 255), Rate = 40, Speed = NumberRange.new(2, 5), Texture = SPARKLE })
	light(core, WHITE, 22, 4)
	return core
end

builders.galaxy = function(m, cf, color)
	local core = orb(m, cf, 1.2, Color3.fromRGB(255, 240, 190))
	local tilt = cf * CFrame.Angles(math.rad(25), 0, 0)
	for arm = 0, 1 do
		for i = 1, 10 do
			local a = arm * math.pi + i * 0.45
			local r = 0.5 + i * 0.26
			orb(m, tilt * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r), 0.55 - i * 0.02, if i % 2 == 0 then Color3.fromRGB(200, 150, 255) else color, 0.15)
		end
	end
	disk(m, tilt, 6, Color3.fromRGB(170, 120, 255), 0.85)
	particles(core, { Color = color, Color2 = Color3.fromRGB(190, 140, 255), Rate = 40, Speed = NumberRange.new(0.5, 1.5), Lifetime = NumberRange.new(2, 3.5), Texture = SPARKLE })
	light(core, color, 22, 3.5)
	return core
end

builders.cosmic = function(m, cf, color)
	local core = orb(m, cf, 0.9, WHITE)
	for i = 0, 23 do
		local tt = i / 23
		local a = tt * math.pi * 4
		orb(m, cf * CFrame.new(math.cos(a) * 1.2, -2.6 + tt * 5.2, math.sin(a) * 1.2), 0.45, if i % 2 == 0 then color else WHITE, 0.05)
		orb(m, cf * CFrame.new(-math.cos(a) * 1.2, -2.6 + tt * 5.2, -math.sin(a) * 1.2), 0.35, Color3.fromRGB(180, 255, 240), 0.2)
	end
	orb(m, cf, 4, color, 0.9)
	particles(core, { Color = color, Color2 = WHITE, Rate = 45, Speed = NumberRange.new(1, 3), Texture = SPARKLE })
	light(core, color, 22, 4)
	return core
end

builders.bigbang = function(m, cf, color)
	local core = orb(m, cf, 2, WHITE)
	orb(m, cf, 2.8, Color3.fromRGB(255, 220, 140), 0.35)
	local rainbow = {
		Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 170, 70), Color3.fromRGB(255, 235, 110),
		Color3.fromRGB(120, 230, 140), Color3.fromRGB(110, 190, 255), Color3.fromRGB(190, 130, 255),
	}
	for i = 1, 22 do
		local rot = CFrame.Angles(i * 1.7, i * 2.3, i * 0.9)
		local length = 2.6 + (i % 4) * 0.5
		bar(m, cf * rot * CFrame.new(0, length / 2, 0), Vector3.new(0.25, length, 0.25), rainbow[i % #rainbow + 1], 0.05)
	end
	orb(m, cf, 6, color, 0.9)
	particles(core, { Color = Color3.fromRGB(255, 240, 200), Color2 = color, Rate = 70, Speed = NumberRange.new(3, 7), Texture = SPARKLE })
	particles(core, { Color = WHITE, Rate = 10, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 5) }) })
	light(core, Color3.fromRGB(255, 220, 170), 26, 5)
	return core
end

builders.infinity = function(m, cf, color)
	local core = orb(m, cf, 1.2, Color3.fromRGB(255, 245, 190))
	for i = 0, 39 do
		local tt = i / 40 * math.pi * 2
		local den = 1 + math.sin(tt) ^ 2
		local x, y = 2.6 * math.cos(tt) / den, 2.6 * math.sin(tt) * math.cos(tt) / den
		orb(m, cf * CFrame.new(x, y, 0), 0.5, if i % 4 == 0 then Color3.fromRGB(255, 220, 120) else color, 0.05)
	end
	for i = 1, 5 do
		-- little crown over the core
		bar(m, cf * CFrame.Angles(0, i * math.pi * 2 / 5, 0) * CFrame.new(0, 1.3, 0.5), Vector3.new(0.18, 0.7, 0.18), Color3.fromRGB(255, 210, 90), 0)
	end
	orb(m, cf, 6, color, 0.9)
	particles(core, { Color = color, Color2 = Color3.fromRGB(255, 220, 140), Rate = 60, Speed = NumberRange.new(1, 3), Texture = SPARKLE })
	particles(core, { Color = WHITE, Rate = 12, Speed = NumberRange.new(4, 8), Lifetime = NumberRange.new(0.5, 1), Texture = SPARKLE })
	light(core, color, 26, 5)
	return core
end

builders.browndwarf = function(m, cf, color)
	local core = orb(m, cf, 1.5, color)
	for i = -2, 2 do
		disk(m, cf * CFrame.new(0, i * 0.22, 0), 1.5 - math.abs(i) * 0.25, Color3.fromRGB(120, 70, 50), 0.4)
	end
	orb(m, cf, 2.2, Color3.fromRGB(140, 70, 40), 0.85)
	particles(core, { Color = Color3.fromRGB(200, 120, 80), Rate = 5 })
	return core
end

builders.whitedwarf = function(m, cf, color)
	local core = orb(m, cf, 0.7, WHITE)
	bar(m, cf, Vector3.new(0.12, 3, 0.12), Color3.fromRGB(220, 235, 255), 0.2)
	bar(m, cf, Vector3.new(3, 0.12, 0.12), Color3.fromRGB(220, 235, 255), 0.2)
	orb(m, cf, 1.6, color, 0.7)
	orb(m, cf, 2.6, color, 0.9)
	particles(core, { Color = WHITE, Color2 = color, Rate = 10, Texture = SPARKLE })
	light(core, color, 10, 1.5)
	return core
end

builders.redgiant = function(m, cf, color)
	local core = orb(m, cf, 2.5, Color3.fromRGB(255, 150, 80))
	orb(m, cf * CFrame.new(-0.5, 0.5, -0.5), 1.2, Color3.fromRGB(255, 190, 120), 0.3)
	orb(m, cf, 3.2, color, 0.7)
	orb(m, cf, 4.2, Color3.fromRGB(200, 60, 30), 0.88)
	particles(core, { Color = Color3.fromRGB(255, 160, 90), Color2 = color, Rate = 14, Acceleration = Vector3.new(0, 1, 0) })
	light(core, color, 14, 1.5)
	return core
end

builders.binary = function(m, cf, color)
	local core = orb(m, cf * CFrame.new(-0.9, 0, 0), 1.2, Color3.fromRGB(255, 220, 140))
	orb(m, cf * CFrame.new(-0.9, 0, 0), 1.8, Color3.fromRGB(255, 180, 80), 0.6)
	orb(m, cf * CFrame.new(1, 0, 0), 0.9, Color3.fromRGB(190, 220, 255))
	orb(m, cf * CFrame.new(1, 0, 0), 1.4, Color3.fromRGB(120, 170, 255), 0.6)
	bar(m, cf, Vector3.new(1.6, 0.15, 0.15), Color3.fromRGB(255, 230, 200), 0.4)
	disk(m, cf, 4.4, color, 0.88)
	particles(core, { Color = color, Color2 = Color3.fromRGB(150, 190, 255), Rate = 14, Texture = SPARKLE })
	light(core, color, 12, 1.5)
	return core
end

builders.wolfrayet = function(m, cf, color)
	local core = orb(m, cf, 0.8, WHITE)
	for i = 1, 14 do
		local a, b = i * 2.4, i * 1.3
		orb(m, cf * CFrame.new(math.cos(a) * 1.8 * math.cos(b), math.sin(b) * 1.5, math.sin(a) * 1.8 * math.cos(b)), 0.6 + (i % 3) * 0.2, if i % 2 == 0 then color else Color3.fromRGB(255, 200, 130), 0.35)
	end
	particles(core, { Color = color, Color2 = WHITE, Rate = 30, Speed = NumberRange.new(2, 4), Texture = SPARKLE })
	light(core, color, 16, 2.5)
	return core
end

builders.hypergiant = function(m, cf, color)
	local core = orb(m, cf, 3, Color3.fromRGB(255, 170, 90))
	orb(m, cf, 3.6, color, 0.6)
	for i = 1, 10 do
		local a = i * 0.63
		orb(m, cf * CFrame.new(math.cos(a) * 2.3, math.sin(i * 1.9) * 1.2, math.sin(a) * 2.3), 1, Color3.fromRGB(255, 120, 60), 0.55)
	end
	orb(m, cf, 5, color, 0.9)
	particles(core, { Color = Color3.fromRGB(255, 170, 90), Color2 = color, Rate = 30, Speed = NumberRange.new(1, 3), Acceleration = Vector3.new(0, 1.5, 0) })
	light(core, color, 20, 3)
	return core
end

builders.kilonova = function(m, cf, color)
	local core = orb(m, cf, 1.6, Color3.fromRGB(255, 240, 200))
	orb(m, cf * CFrame.new(-0.35, 0, 0), 0.6, WHITE)
	orb(m, cf * CFrame.new(0.35, 0, 0), 0.6, WHITE)
	orb(m, cf, 2.6, color, 0.5)
	orb(m, cf, 4, Color3.fromRGB(255, 120, 60), 0.85)
	particles(core, { Color = color, Color2 = Color3.fromRGB(255, 100, 60), Rate = 50, Speed = NumberRange.new(3, 6), Texture = SPARKLE })
	light(core, color, 20, 3)
	return core
end

builders.eventhorizon = function(m, cf, color)
	local core = part(m, { Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.8, CFrame = cf, Material = Enum.Material.SmoothPlastic, Color = Color3.new(0, 0, 0) })
	local ringCf = cf * CFrame.Angles(math.rad(75), 0, 0)
	disk(m, ringCf, 3.6, color, 0.2)
	disk(m, ringCf, 2.6, Color3.fromRGB(255, 220, 150), 0.1)
	disk(m, cf * CFrame.Angles(0, 0, math.rad(90)), 2.4, Color3.fromRGB(255, 170, 80), 0.5)
	particles(core, { Color = color, Color2 = Color3.fromRGB(255, 220, 160), Rate = 40, Speed = NumberRange.new(0.5, 1.5), Texture = SPARKLE })
	light(core, color, 20, 3)
	return core
end

builders.darkmatter = function(m, cf, color)
	local core = orb(m, cf, 1.2, Color3.fromRGB(60, 30, 100))
	for i = 1, 8 do
		local a = i * 0.785
		orb(m, cf * CFrame.new(math.cos(a) * 1.7, math.sin(i * 2.1) * 0.8, math.sin(a) * 1.7), 1.2, color, 0.75)
	end
	disk(m, cf * CFrame.Angles(math.rad(30), 0, 0), 5, Color3.fromRGB(200, 170, 255), 0.85)
	particles(core, { Color = color, Color2 = Color3.fromRGB(40, 20, 80), Rate = 40, Speed = NumberRange.new(0.3, 1), Lifetime = NumberRange.new(2, 4) })
	light(core, color, 18, 2)
	return core
end

builders.multiverse = function(m, cf, color)
	local core = orb(m, cf, 0.8, WHITE)
	local tints = { Color3.fromRGB(120, 220, 255), Color3.fromRGB(255, 140, 220), Color3.fromRGB(160, 255, 170), Color3.fromRGB(255, 220, 120), Color3.fromRGB(200, 160, 255) }
	for i, tint in tints do
		local a = i * 1.26
		local p = cf * CFrame.new(math.cos(a) * 1.9, math.sin(i * 1.7) * 0.9, math.sin(a) * 1.9)
		orb(m, p, 1.3, tint, 0.45)
		orb(m, p, 0.4, WHITE, 0)
	end
	particles(core, { Color = color, Color2 = Color3.fromRGB(255, 160, 230), Rate = 50, Texture = SPARKLE })
	light(core, color, 22, 3.5)
	return core
end

builders.cosmicweb = function(m, cf, color)
	local core = orb(m, cf, 0.9, WHITE)
	local nodes = {}
	for i = 1, 9 do
		local a, b = i * 2.39, i * 0.9
		local p = cf * CFrame.new(math.cos(a) * 2.3 * math.cos(b), math.sin(b) * 2, math.sin(a) * 2.3 * math.cos(b))
		table.insert(nodes, p.Position)
		orb(m, p, 0.45, WHITE, 0)
	end
	for i = 1, #nodes do
		for j = i + 1, #nodes do
			local a, b = nodes[i], nodes[j]
			if (a - b).Magnitude < 2.8 then
				bar(m, CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(math.rad(90), 0, 0), Vector3.new(0.1, (a - b).Magnitude, 0.1), color, 0.2)
			end
		end
	end
	particles(core, { Color = color, Color2 = WHITE, Rate = 40, Texture = SPARKLE })
	light(core, color, 22, 3.5)
	return core
end

-- named stars borrow the look of a type
KIND_BUILDERS = {
	sphere = "sun", point = "whitedwarf", giant = "redgiant", binary = "binary", pulsar = "pulsar", blackhole = "eventhorizon",
	magnetar = "magnetar", nebula = "nebula", remnant = "supernova", galaxy = "galaxy", lens = "whitehole", quasar = "quasar",
}

-- star, mutation, level -> Model at position
function StarModels.create(star, mutation, level: number, position: Vector3, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = star.id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- arrives on clients in one piece
	local scale = 1.3 + (level - 1) * 0.1
	local cf = CFrame.new(position)
	local builder = builders[star.id] or builders[KIND_BUILDERS[star.kind or ""] or ""] or builders.dwarf
	local core = builder(model, cf, star.color)
	model.PrimaryPart = core

	-- glow ring on the pedestal top (outside the model so it doesn't spin or bob)
	part(parent :: any, {
		Name = "Halo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.08, 3.4, 3.4),
		CFrame = CFrame.new(position - Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon, Color = star.color, Transparency = 0.55,
	})

	if mutation.id ~= "normal" then
		particles(core, {
			Color = mutation.color, Rate = 6 + mutation.index * 4, Texture = SPARKLE,
			Speed = NumberRange.new(1, 2), Lifetime = NumberRange.new(1, 2),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		})
		orb(model, cf, 3 + mutation.index * 0.3, mutation.color, 0.88)
	end

	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	model:SetAttribute("Spin", 20 + star.index * 6)
	model:SetAttribute("Base", CFrame.new(position)) -- the client spins around this (never trust a half-loaded pivot)
	model.Parent = parent
	CollectionService:AddTag(model, "StarModel")
	return model
end

return StarModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Builds the sky world at runtime and renders stars on each plot's pedestals.
-- Look: bright heaven. White marble, warm gold trim, soft clouds, pastel trees, glassy blue.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Sky = require(Shared.Sky)
local Evolution = require(Shared.Evolution)
local StarModels = require(script.Parent.StarModels)

local World = {}

-- callbacks set by Main
World.onPlotTouched = nil :: ((Player, number) -> ())?
World.onPedestal = nil :: ((Player, number, string) -> ())?
World.onForge = nil :: ((Player) -> ())?
World.onHole = nil :: ((Player) -> ())?

local RING = 150 -- distance from hub center to satellite islands
local HUB_RADIUS = 50
local PLOT_SIZE = 64
local SPACING = 7
local STAR_HEIGHT = 4.2

local MARBLE = Color3.fromRGB(246, 246, 250)
local MARBLE_WARM = Color3.fromRGB(238, 232, 220)
local GOLD = Color3.fromRGB(236, 196, 100)
local GRASS = Color3.fromRGB(146, 214, 140)
local GLASS = Color3.fromRGB(170, 220, 255)
local CLOUD = Color3.fromRGB(255, 255, 255)

local rng = Random.new(20261114)
local plots = {}
local playerPlot: { [Player]: number } = {}
World.ForgePosition = Vector3.zero
World.AltarPosition = Vector3.zero

---------------------------------------------------------------- helpers
local function make(className: string, props)
	local inst = Instance.new(className)
	if props.Shape then
		inst.Shape = props.Shape -- shape first, so it doesn't reset the size
	end
	if inst:IsA("BasePart") then
		inst.Anchored = true
		inst.TopSurface = Enum.SurfaceType.Smooth
		inst.BottomSurface = Enum.SurfaceType.Smooth
	end
	for key, value in props do
		if key ~= "Parent" and key ~= "Shape" then
			inst[key] = value
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function cylinder(cf: CFrame, height: number, diameter: number, props)
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	return make("Part", props)
end

local function ball(position: Vector3, diameter: number, props)
	props.Shape = Enum.PartType.Ball
	props.Size = Vector3.new(diameter, diameter, diameter)
	props.CFrame = CFrame.new(position)
	return make("Part", props)
end

local function cloudPuff(center: Vector3, size: number, parent: Instance, count: number?)
	for _ = 1, count or 5 do
		local offset = Vector3.new(rng:NextNumber(-1, 1) * size * 0.6, rng:NextNumber(-0.25, 0.25) * size, rng:NextNumber(-1, 1) * size * 0.6)
		ball(center + offset, size * rng:NextNumber(0.5, 0.9), {
			Color = CLOUD, Material = Enum.Material.SmoothPlastic, Transparency = 0.08,
			CanCollide = false, CastShadow = false, Parent = parent,
		})
	end
end

-- Text in the world. Client re-localizes everything tagged WorldText.
local function worldText(adornee: BasePart, langKey: string, offset: number, studsWide: number, studsTall: number?)
	local gui = make("BillboardGui", {
		Size = UDim2.new(studsWide, 0, studsTall or 3, 0),
		StudsOffset = Vector3.new(0, offset, 0),
		MaxDistance = 160,
		LightInfluence = 0,
		Parent = adornee,
	})
	local label = make("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = langKey,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextStrokeColor3 = Color3.fromRGB(40, 70, 120),
		TextStrokeTransparency = 0.1,
		TextScaled = true,
		FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json"),
		Parent = gui,
	})
	label:SetAttribute("LangKey", langKey)
	CollectionService:AddTag(label, "WorldText")
	return label
end

local function prompt(parent: BasePart, name: string, langKey: string, objKey: string?, distance: number?)
	local p = make("ProximityPrompt", {
		Name = name,
		ActionText = langKey,
		ObjectText = "",
		HoldDuration = 0,
		MaxActivationDistance = distance or 12,
		RequiresLineOfSight = false,
		Parent = parent,
	})
	p:SetAttribute("LangKey", langKey)
	if objKey then
		p:SetAttribute("ObjKey", objKey)
	end
	CollectionService:AddTag(p, "WorldPrompt")
	return p
end

-- round floating island: marble top, gold rim, clouds hugging the underside
local function roundIsland(center: Vector3, radius: number, parent: Instance, topColor: Color3?, topMaterial: Enum.Material?)
	cylinder(CFrame.new(center + Vector3.new(0, -2, 0)), 4, radius * 2, { Name = "Floor", Material = topMaterial or Enum.Material.Marble, Color = topColor or MARBLE, Parent = parent })
	cylinder(CFrame.new(center + Vector3.new(0, -2.4, 0)), 3.6, radius * 2 + 2, { Name = "Rim", Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = parent })
	cylinder(CFrame.new(center + Vector3.new(0, -7, 0)), 6, radius * 1.7, { Name = "Base", Material = Enum.Material.Marble, Color = MARBLE_WARM, Parent = parent })
	for _ = 1, math.floor(radius / 4) do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0, radius * 0.8)
		cloudPuff(center + Vector3.new(math.cos(a) * r, -11 - rng:NextNumber(0, 4), math.sin(a) * r), rng:NextNumber(10, 18), parent, 3)
	end
end

local function pillar(base: Vector3, height: number, parent: Instance)
	cylinder(CFrame.new(base + Vector3.new(0, 0.6, 0)), 1.2, 4, { Name = "PillarFoot", Material = Enum.Material.Marble, Color = MARBLE, Parent = parent })
	cylinder(CFrame.new(base + Vector3.new(0, height / 2, 0)), height, 2.6, { Name = "Pillar", Material = Enum.Material.Marble, Color = MARBLE, Parent = parent })
	cylinder(CFrame.new(base + Vector3.new(0, height + 0.5, 0)), 1, 3.8, { Name = "PillarCap", Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = parent })
end

local function crystal(position: Vector3, size: number, color: Color3, parent: Instance)
	local c = make("Part", {
		Name = "Crystal",
		Size = Vector3.new(size, size * 1.6, size),
		CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(45), math.rad(45)),
		Material = Enum.Material.Glass,
		Color = color,
		Transparency = 0.2,
		CanCollide = false,
		Parent = parent,
	})
	make("PointLight", { Color = color, Range = size * 4, Brightness = 1, Parent = c })
	return c
end

local FLOWERS = { Color3.fromRGB(255, 160, 200), Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 170, 255) }
local function flowers(center: Vector3, radius: number, count: number, parent: Instance)
	for _ = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(radius * 0.4, radius)
		local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		make("Part", { Name = "Stem", Size = Vector3.new(0.15, 0.9, 0.15), CFrame = CFrame.new(p + Vector3.new(0, 0.45, 0)), Color = Color3.fromRGB(90, 170, 80), CanCollide = false, CastShadow = false, Parent = parent })
		ball(p + Vector3.new(0, 1, 0), rng:NextNumber(0.6, 0.9), { Name = "Flower", Material = Enum.Material.SmoothPlastic, Color = FLOWERS[rng:NextInteger(1, #FLOWERS)], CanCollide = false, CastShadow = false, Parent = parent })
	end
end

local function tree(base: Vector3, parent: Instance, leafColor: Color3)
	local height = rng:NextNumber(7, 10)
	make("Part", {
		Name = "Trunk", Size = Vector3.new(1.4, height, 1.4), CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)),
		Material = Enum.Material.Wood, Color = Color3.fromRGB(235, 228, 214), Parent = parent,
	})
	for _ = 1, 4 do
		ball(base + Vector3.new(rng:NextNumber(-2, 2), height + rng:NextNumber(-1, 2), rng:NextNumber(-2, 2)), rng:NextNumber(5, 7), {
			Name = "Leaves", Material = Enum.Material.SmoothPlastic, Color = leafColor, CanCollide = false, Parent = parent,
		})
	end
end

local WOOD = Color3.fromRGB(166, 112, 70)
local WOOD_DARK = Color3.fromRGB(120, 78, 48)
local BRIDGE_RISE = 6 -- how high the middle of the arch goes

local function bridge(direction: Vector3, from: number, to: number, parent: Instance)
	local length = to - from
	local segments = math.max(8, math.floor(length / 5))
	local side = Vector3.new(-direction.Z, 0, direction.X) -- horizontal, across the bridge
	local function point(t: number): Vector3
		return direction * (from + length * t) + Vector3.new(0, math.sin(math.pi * t) * BRIDGE_RISE, 0)
	end

	for i = 0, segments - 1 do
		local a, b = point(i / segments), point((i + 1) / segments)
		local segLength = (b - a).Magnitude + 0.6 -- small overlap: no gaps or bumps
		local cf = CFrame.lookAt((a + b) / 2, b, Vector3.yAxis)
		-- planks
		make("Part", { Name = "Deck", Size = Vector3.new(11, 1, segLength), CFrame = cf * CFrame.new(0, -0.5, 0), Material = Enum.Material.WoodPlanks, Color = WOOD, Parent = parent })
		-- rails on both sides
		for _, s in { -5.6, 5.6 } do
			make("Part", { Name = "Rail", Size = Vector3.new(0.5, 0.5, segLength), CFrame = cf * CFrame.new(s, 2.6, 0), Material = Enum.Material.Wood, Color = WOOD_DARK, Parent = parent })
		end
	end
	-- posts at every joint, lanterns in the middle
	for i = 0, segments do
		local t = i / segments
		local base = point(t)
		for _, s in { -5.6, 5.6 } do
			local postPos = base + side * s + Vector3.new(0, 1.5, 0)
			make("Part", { Name = "Post", Size = Vector3.new(0.7, 3.4, 0.7), CFrame = CFrame.new(postPos), Material = Enum.Material.Wood, Color = WOOD_DARK, Parent = parent })
			if i == math.floor(segments / 2) then
				local lamp = make("Part", { Name = "Lantern", Size = Vector3.new(1, 1.2, 1), CFrame = CFrame.new(postPos + Vector3.new(0, 2.3, 0)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 214, 150), CanCollide = false, Parent = parent })
				make("PointLight", { Color = Color3.fromRGB(255, 200, 140), Range = 12, Brightness = 1, Parent = lamp })
			end
		end
	end

	-- arch at the hub end
	local archCF = CFrame.lookAt(direction * (from + 2), Vector3.zero)
	for _, side in { -7, 7 } do
		pillar((archCF * CFrame.new(side, 0, 0)).Position, 12, parent)
	end
	make("Part", { Name = "ArchBeam", Size = Vector3.new(17, 1.6, 2.4), CFrame = archCF * CFrame.new(0, 13.4, 0), Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = parent })
	-- cloud tufts under the bridge
	for t = 0.2, 0.8, 0.3 do
		cloudPuff(point(t) + Vector3.new(0, -7, 0), 9, parent, 2)
	end
end

local function directionAt(slot: number): Vector3
	local angle = (slot - 1) / 8 * math.pi * 2
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

---------------------------------------------------------------- atmosphere
local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(150, 170, 200)
	Lighting.OutdoorAmbient = Color3.fromRGB(175, 195, 225)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	make("Atmosphere", {
		Density = 0.28, Offset = 0.1,
		Color = Color3.fromRGB(205, 228, 255), Decay = Color3.fromRGB(150, 190, 240),
		Glare = 0.25, Haze = 1.4, Parent = Lighting,
	})
	make("Sky", { CelestialBodiesShown = true, SunAngularSize = 14, StarCount = 0, Parent = Lighting })
	make("BloomEffect", { Intensity = 0.2, Size = 18, Threshold = 2, Parent = Lighting })
	make("SunRaysEffect", { Intensity = 0.06, Spread = 0.8, Parent = Lighting })
	make("ColorCorrectionEffect", { Brightness = 0.03, Contrast = 0.05, Saturation = 0.12, TintColor = Color3.fromRGB(255, 252, 245), Parent = Lighting })

	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		make("Clouds", { Cover = 0.55, Density = 0.6, Color = Color3.fromRGB(255, 255, 255), Parent = terrain })
	end
end

---------------------------------------------------------------- hub
local function buildHub(folder: Folder)
	roundIsland(Vector3.zero, HUB_RADIUS, folder)
	-- gold compass inlay
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		make("Part", {
			Name = "Inlay", Size = Vector3.new(0.6, 0.12, 30),
			CFrame = CFrame.new(math.cos(a) * 22, 0.06, math.sin(a) * 22) * CFrame.Angles(0, -a - math.pi / 2, 0),
			Material = Enum.Material.SmoothPlastic, Color = GOLD, CanCollide = false, Parent = folder,
		})
	end

	-- fountain
	cylinder(CFrame.new(0, 1, 0), 2, 26, { Name = "Basin", Material = Enum.Material.Marble, Color = MARBLE, Parent = folder })
	cylinder(CFrame.new(0, 2.05, 0), 0.2, 23, { Name = "Water", Material = Enum.Material.Glass, Color = Color3.fromRGB(120, 200, 255), Transparency = 0.25, CanCollide = false, Parent = folder })
	cylinder(CFrame.new(0, 5, 0), 6, 3, { Name = "Column", Material = Enum.Material.Marble, Color = MARBLE, Parent = folder })
	cylinder(CFrame.new(0, 8.2, 0), 0.8, 9, { Name = "Bowl", Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = folder })
	local orb = ball(Vector3.new(0, 11.5, 0), 4, { Name = "Orb", Material = Enum.Material.Neon, Color = Color3.fromRGB(170, 230, 255), CanCollide = false, Parent = folder })
	make("PointLight", { Color = Color3.fromRGB(170, 230, 255), Range = 24, Brightness = 1.5, Parent = orb })
	make("ParticleEmitter", {
		Color = ColorSequence.new(Color3.fromRGB(200, 240, 255)), LightEmission = 0.6, Rate = 18,
		Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(3, 6), SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, -8, 0), Size = NumberSequence.new(0.5, 0), Transparency = NumberSequence.new(0.2, 1),
		Parent = orb,
	})
	worldText(orb, "signHub", 6, 22, 4)

	-- pillars with floating crystals between the bridges
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		local base = Vector3.new(math.cos(a) * 43, 0, math.sin(a) * 43)
		if i >= 4 then
			continue -- the leaderboard tablets stand on this half of the edge
		end
		pillar(base, 14, folder)
		crystal(base + Vector3.new(0, 18, 0), 2.2, if i % 2 == 0 then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(190, 255, 220), folder)
	end

	-- drifting golden sparkles above the island
	local air = make("Part", { Name = "AirSparkles", Size = Vector3.new(90, 1, 90), CFrame = CFrame.new(0, 6, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	make("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(Color3.fromRGB(255, 240, 190), Color3.fromRGB(190, 230, 255)),
		LightEmission = 1, LightInfluence = 0, Rate = 14, Lifetime = NumberRange.new(5, 9), Speed = NumberRange.new(0.4, 1.2),
		SpreadAngle = Vector2.new(180, 180), RotSpeed = NumberRange.new(-40, 40),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		Parent = air,
	})

	-- trees
	local leaves = { Color3.fromRGB(255, 205, 225), Color3.fromRGB(190, 240, 205), Color3.fromRGB(255, 230, 190), Color3.fromRGB(215, 205, 255) }
	for i = 1, 4 do
		local a = math.rad(22.5 + (i - 1) * 45)
		local base = Vector3.new(math.cos(a) * 31, 0, math.sin(a) * 31)
		tree(base, folder, leaves[i])
		flowers(base, 5, 10, folder)
	end

	-- stone leaderboard tablets (the client draws the scrollable lists on them)
	local boards = make("Folder", { Name = "Leaderboards", Parent = folder })
	for i, board in { "rolls", "rebirths", "cash", "rarest" } do
		local a = math.rad(202.5 + (i - 1) * 45)
		local pos = Vector3.new(math.cos(a) * 45, 0, math.sin(a) * 45)
		local cf = CFrame.lookAt(pos, Vector3.zero)
		make("Part", { Name = "Step", Size = Vector3.new(10.5, 1.2, 4), CFrame = cf * CFrame.new(0, 0.6, 0), Material = Enum.Material.Slate, Color = Color3.fromRGB(118, 120, 132), Parent = folder })
		make("Part", { Name = "Board_" .. board, Size = Vector3.new(9, 12, 1.2), CFrame = cf * CFrame.new(0, 7.2, 0), Material = Enum.Material.Slate, Color = Color3.fromRGB(172, 174, 186), Parent = boards })
		make("Part", { Name = "Cap", Size = Vector3.new(10, 0.8, 2), CFrame = cf * CFrame.new(0, 13.6, 0), Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = folder })
		crystal((cf * CFrame.new(0, 15.4, 0)).Position, 1.3, Color3.fromRGB(255, 220, 120), folder)
	end

	-- the spawn plate stays but invisible
	local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
	if spawn then
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CFrame = CFrame.new(0, 0.5, 20)
		for _, child in spawn:GetChildren() do
			if child:IsA("Decal") then
				child:Destroy()
			end
		end
	end
end

---------------------------------------------------------------- Star Forge house (on the hub, next to spawn)
local function buildForgeHouse(folder: Folder)
	-- front faces the hub center (local -Z)
	local cf = CFrame.lookAt(Vector3.new(0, 0, 33), Vector3.zero)
	local BRICK = Color3.fromRGB(222, 170, 140)
	local ROOF = Color3.fromRGB(96, 150, 232)
	make("Part", { Name = "HouseFloor", Size = Vector3.new(17, 0.4, 15), CFrame = cf * CFrame.new(0, 0.2, 0), Material = Enum.Material.Marble, Color = MARBLE_WARM, Parent = folder })
	make("Part", { Name = "BackWall", Size = Vector3.new(17, 10, 1), CFrame = cf * CFrame.new(0, 5, 7), Material = Enum.Material.Brick, Color = BRICK, Parent = folder })
	for _, side in { -8, 8 } do
		make("Part", { Name = "SideWall", Size = Vector3.new(1, 10, 15), CFrame = cf * CFrame.new(side, 5, 0), Material = Enum.Material.Brick, Color = BRICK, Parent = folder })
		pillar((cf * CFrame.new(side, 0, -7.5)).Position, 10, folder)
	end
	make("Part", { Name = "Ceiling", Size = Vector3.new(19, 1, 17), CFrame = cf * CFrame.new(0, 10.6, 0), Material = Enum.Material.Marble, Color = MARBLE, Parent = folder })
	for _, side in { -1, 1 } do
		make("Part", {
			Name = "Roof", Size = Vector3.new(11, 0.8, 18), CFrame = cf * CFrame.new(side * 4.6, 13.2, 0) * CFrame.Angles(0, 0, math.rad(-28 * side)),
			Material = Enum.Material.SmoothPlastic, Color = ROOF, Parent = folder,
		})
	end
	local chimney = cylinder(cf * CFrame.new(5, 15, 4), 6, 2.4, { Name = "Chimney", Material = Enum.Material.Brick, Color = BRICK, Parent = folder })
	make("Smoke", { Color = Color3.fromRGB(255, 255, 255), Opacity = 0.15, RiseVelocity = 4, Size = 2, Parent = chimney })

	-- furnace at the back
	local furnace = make("Part", { Name = "Furnace", Size = Vector3.new(8, 5, 3), CFrame = cf * CFrame.new(0, 2.5, 5), Material = Enum.Material.Brick, Color = Color3.fromRGB(190, 130, 105), Parent = folder })
	local mouth = make("Part", { Name = "Mouth", Size = Vector3.new(4, 2.2, 0.3), CFrame = furnace.CFrame * CFrame.new(0, -0.8, -1.6), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 130, 40), Parent = folder })
	make("Fire", { Heat = 4, Size = 3, Color = Color3.fromRGB(255, 140, 50), SecondaryColor = Color3.fromRGB(255, 230, 140), Parent = mouth })
	make("PointLight", { Color = Color3.fromRGB(255, 150, 70), Range = 16, Brightness = 2, Parent = mouth })

	-- forge table in front
	local tableBase = make("Part", { Name = "ForgeTable", Size = Vector3.new(6, 3, 3.5), CFrame = cf * CFrame.new(0, 1.7, -3), Material = Enum.Material.Marble, Color = Color3.fromRGB(125, 125, 140), Parent = folder })
	local anvil = make("Part", { Name = "Anvil", Size = Vector3.new(5, 1.2, 2.2), CFrame = cf * CFrame.new(0, 3.8, -3), Material = Enum.Material.Metal, Color = Color3.fromRGB(80, 84, 96), Parent = folder })
	make("ParticleEmitter", {
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 120, 40)), LightEmission = 1, Rate = 6,
		Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, -20, 0), Size = NumberSequence.new(0.25, 0), Parent = anvil,
	})
	local forgePrompt = prompt(tableBase, "ForgePrompt", "promptForge", nil, 12)
	forgePrompt.Triggered:Connect(function(who)
		if World.onForge then
			World.onForge(who)
		end
	end)
	World.ForgePosition = tableBase.Position

	-- banner over the entrance
	local banner = make("Part", { Name = "Banner", Size = Vector3.new(12, 2.4, 0.4), CFrame = cf * CFrame.new(0, 9, -8.3), Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = folder })
	worldText(banner, "signForge", 0, 14, 2.6)
end

---------------------------------------------------------------- Black Hole island
local function buildBlackHole(folder: Folder, slot: number)
	local direction = directionAt(slot)
	local center = direction * RING
	World.AltarPosition = center
	roundIsland(center, 34, folder, Color3.fromRGB(42, 34, 58), Enum.Material.Basalt) -- obsidian
	bridge(direction, HUB_RADIUS - 2, RING - 33, folder)

	local holePos = center + Vector3.new(0, 34, 0)
	local hole = ball(holePos, 20, { Name = "BlackHole", Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = false, Parent = folder })
	make("PointLight", { Color = Color3.fromRGB(180, 110, 255), Range = 60, Brightness = 3, Parent = hole })
	local disk = cylinder(CFrame.new(holePos) * CFrame.Angles(math.rad(16), 0, math.rad(8)), 0.4, 50, {
		Name = "Disk", Material = Enum.Material.Neon, Color = Color3.fromRGB(176, 110, 255), Transparency = 0.35, CanCollide = false, CastShadow = false, Parent = folder,
	})
	cylinder(CFrame.new(holePos) * CFrame.Angles(math.rad(16), 0, math.rad(8)), 0.5, 32, {
		Name = "InnerDisk", Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 150, 220), Transparency = 0.25, CanCollide = false, CastShadow = false, Parent = folder,
	})
	make("ParticleEmitter", {
		Color = ColorSequence.new(Color3.fromRGB(220, 170, 255), Color3.fromRGB(110, 50, 200)), LightEmission = 1, Rate = 40,
		Lifetime = NumberRange.new(1.5, 3), Speed = NumberRange.new(0.5, 2), Size = NumberSequence.new(0.7, 0), Parent = disk,
	})
	local FIRE = Color3.fromRGB(255, 120, 40)
	local VIOLET = Color3.fromRGB(176, 110, 255)

	-- second, steeper accretion ring
	cylinder(CFrame.new(holePos) * CFrame.Angles(math.rad(-58), math.rad(30), 0), 0.3, 40, {
		Name = "OuterDisk", Material = Enum.Material.Neon, Color = FIRE, Transparency = 0.55, CanCollide = false, CastShadow = false, Parent = folder,
	})

	-- particles sucked into the hole from every direction
	local vortex = ball(holePos, 70, { Name = "Vortex", Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false, Parent = folder })
	make("ParticleEmitter", {
		Shape = Enum.ParticleEmitterShape.Sphere, ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), VIOLET),
		LightEmission = 1, LightInfluence = 0, Rate = 60, Lifetime = NumberRange.new(2, 2.6), Speed = NumberRange.new(13, 16),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.7, 0.8), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0), NumberSequenceKeypoint.new(1, 0.4) }),
		Parent = vortex,
	})

	-- burning meteors orbiting the hole: welded to one anchored hub that the server spins
	local orbitHub = make("Part", { Name = "OrbitHub", Size = Vector3.one, CFrame = CFrame.new(holePos), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local r = rng:NextNumber(22, 32)
		local size = rng:NextNumber(2, 4.5)
		local rock = make("Part", {
			Name = "Meteor", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size * 0.85, size), Anchored = false, Massless = true,
			CFrame = CFrame.new(holePos + Vector3.new(math.cos(a) * r, rng:NextNumber(-7, 7), math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0),
			Material = Enum.Material.Basalt, Color = Color3.fromRGB(55, 40, 45), CanCollide = false, CanQuery = false, Parent = folder,
		})
		rock.Anchored = false
		make("WeldConstraint", { Part0 = orbitHub, Part1 = rock, Parent = rock })
		if i % 2 == 0 then
			make("Fire", { Heat = 8, Size = size * 1.6, Color = FIRE, SecondaryColor = Color3.fromRGB(255, 220, 120), Parent = rock })
		else
			make("Fire", { Heat = 6, Size = size * 1.4, Color = VIOLET, SecondaryColor = Color3.fromRGB(255, 150, 220), Parent = rock })
		end
		local t0 = make("Attachment", { Position = Vector3.new(0, size * 0.3, 0), Parent = rock })
		local t1 = make("Attachment", { Position = Vector3.new(0, -size * 0.3, 0), Parent = rock })
		make("Trail", {
			Attachment0 = t0, Attachment1 = t1, Lifetime = 0.8, LightEmission = 1, FaceCamera = true,
			Color = ColorSequence.new(if i % 2 == 0 then FIRE else VIOLET, Color3.fromRGB(80, 30, 60)),
			Transparency = NumberSequence.new(0.1, 1), Parent = rock,
		})
		make("PointLight", { Color = if i % 2 == 0 then FIRE else VIOLET, Range = 10, Brightness = 1.2, Parent = rock })
	end
	task.spawn(function()
		local angle = 0
		while orbitHub.Parent do
			angle += task.wait(0.05) * 0.35
			orbitHub.CFrame = CFrame.new(holePos) * CFrame.Angles(math.rad(12), angle, 0)
		end
	end)

	-- lava cracks in the obsidian floor
	for i = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(8, 28)
		make("Part", {
			Name = "LavaCrack", Size = Vector3.new(rng:NextNumber(0.3, 0.7), 0.12, rng:NextNumber(4, 10)),
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * r, 0.06, math.sin(a) * r)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
			Material = Enum.Material.Neon, Color = if i % 3 == 0 then VIOLET else FIRE, CanCollide = false, Parent = folder,
		})
	end
	-- burning rocks lying around + fire braziers
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2 + 0.2
		local pos = center + Vector3.new(math.cos(a) * 25, 1.2, math.sin(a) * 25)
		local rock = make("Part", {
			Name = "Rock", Size = Vector3.new(rng:NextNumber(3, 5), rng:NextNumber(2, 3.5), rng:NextNumber(3, 5)),
			CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			Material = Enum.Material.Basalt, Color = Color3.fromRGB(45, 35, 50), Parent = folder,
		})
		if i % 2 == 0 then
			make("Fire", { Heat = 7, Size = 5, Color = FIRE, SecondaryColor = Color3.fromRGB(255, 220, 120), Parent = rock })
			make("Smoke", { Color = Color3.fromRGB(60, 40, 70), Opacity = 0.25, RiseVelocity = 5, Size = 3, Parent = rock })
		end
	end
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local base = center + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
		cylinder(CFrame.new(base + Vector3.new(0, 2, 0)), 4, 1.4, { Name = "BrazierStand", Material = Enum.Material.Metal, Color = Color3.fromRGB(60, 50, 70), Parent = folder })
		local bowl = cylinder(CFrame.new(base + Vector3.new(0, 4.3, 0)), 0.8, 3.2, { Name = "Brazier", Material = Enum.Material.Metal, Color = Color3.fromRGB(80, 60, 90), Parent = folder })
		make("Fire", { Heat = 9, Size = 4, Color = VIOLET, SecondaryColor = Color3.fromRGB(255, 160, 230), Parent = bowl })
		make("PointLight", { Color = VIOLET, Range = 14, Brightness = 1.5, Parent = bowl })
	end
	-- lightning-like arcs from the hole down to big crystals
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		local c = crystal(center + Vector3.new(math.cos(a) * 19, 5, math.sin(a) * 19), 3.2, VIOLET, folder)
		local from = make("Attachment", { Parent = hole })
		local to = make("Attachment", { Parent = c })
		make("Beam", {
			Attachment0 = from, Attachment1 = to, Color = ColorSequence.new(Color3.fromRGB(230, 200, 255), VIOLET), LightEmission = 1,
			Width0 = 0.6, Width1 = 0.3, CurveSize0 = 8, CurveSize1 = -6, Segments = 20, FaceCamera = true,
			Transparency = NumberSequence.new(0.1, 0.5), Parent = c,
		})
	end

	-- every few seconds a fresh meteor falls into the hole and bursts
	task.spawn(function()
		while hole.Parent do
			task.wait(rng:NextNumber(2.5, 5))
			local a = rng:NextNumber(0, math.pi * 2)
			local startPos = holePos + Vector3.new(math.cos(a) * 110, rng:NextNumber(50, 90), math.sin(a) * 110)
			local meteor = ball(startPos, rng:NextNumber(2, 3.5), { Name = "FallingMeteor", Material = Enum.Material.Basalt, Color = Color3.fromRGB(60, 40, 40), CanCollide = false, CanQuery = false, Parent = folder })
			make("Fire", { Heat = 15, Size = 8, Color = FIRE, SecondaryColor = Color3.fromRGB(255, 230, 140), Parent = meteor })
			local m0 = make("Attachment", { Position = Vector3.new(0, 1, 0), Parent = meteor })
			local m1 = make("Attachment", { Position = Vector3.new(0, -1, 0), Parent = meteor })
			make("Trail", { Attachment0 = m0, Attachment1 = m1, Lifetime = 1.2, LightEmission = 1, FaceCamera = true, WidthScale = NumberSequence.new(1, 0),
				Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), FIRE), Transparency = NumberSequence.new(0, 1), Parent = meteor })
			local flight = TweenService:Create(meteor, TweenInfo.new(2.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(holePos) })
			flight:Play()
			flight.Completed:Wait()
			local burst = make("ParticleEmitter", {
				Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(Color3.fromRGB(255, 220, 140), VIOLET), LightEmission = 1,
				Lifetime = NumberRange.new(0.6, 1.4), Speed = NumberRange.new(15, 30), SpreadAngle = Vector2.new(180, 180), Rate = 0,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = meteor,
			})
			meteor.Transparency = 1
			for _, child in meteor:GetChildren() do
				if child:IsA("Fire") then
					child.Enabled = false
				end
			end
			burst:Emit(60)
			task.delay(2, function()
				meteor:Destroy()
			end)
		end
	end)

	-- altar with a beam to the hole
	local altar = cylinder(CFrame.new(center + Vector3.new(0, 1.5, 0)), 3, 10, { Name = "Altar", Material = Enum.Material.Basalt, Color = Color3.fromRGB(40, 32, 60), Parent = folder })
	local top = cylinder(CFrame.new(center + Vector3.new(0, 3.15, 0)), 0.3, 8, { Name = "AltarTop", Material = Enum.Material.Neon, Color = Color3.fromRGB(176, 110, 255), Parent = folder })
	local a0 = make("Attachment", { Parent = top })
	local a1 = make("Attachment", { Parent = hole })
	make("Beam", {
		Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(Color3.fromRGB(200, 150, 255)),
		LightEmission = 1, Width0 = 1.2, Width1 = 4, FaceCamera = true, Transparency = NumberSequence.new(0.2, 0.7), Parent = top,
	})
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		crystal(center + Vector3.new(math.cos(a) * 14, 3, math.sin(a) * 14), 2, Color3.fromRGB(190, 140, 255), folder)
	end
	prompt(altar, "BlackHolePrompt", "promptHole", nil, 14).Triggered:Connect(function(who)
		if World.onHole then
			World.onHole(who)
		end
	end)
	worldText(altar, "signHole", 7, 20, 3.5)
end

---------------------------------------------------------------- plots
-- Plot cells: invisible build markers on every cell, slabs (with prompts) where the owner built them
local function buildCells(plot, size: number, slabs, grid)
	plot.pedestals:ClearAllChildren()
	plot.markers:ClearAllChildren()
	plot.cells = {}
	-- the grid grows from one corner, so making the plot bigger never moves what is already built
	local start = -(Config.MaxGridSize - 1) * SPACING / 2
	for y = 1, size do
		for x = 1, size do
			local key = Sky.key(x, y)
			local cf = plot.cf * CFrame.new(start + (x - 1) * SPACING, 0, start + (y - 1) * SPACING)
			plot.cells[key] = { cf = cf }
			make("Part", {
				Name = key, Size = Vector3.new(6, 0.3, 6), CFrame = cf * CFrame.new(0, 0.2, 0), Transparency = 1,
				CanCollide = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(120, 230, 140), Parent = plot.markers,
			})
			local slab = Config.SlabsById[slabs[key]]
			if slab then
				local base = make("Part", {
					Name = key, Size = Vector3.new(6, 0.9, 6), CFrame = cf * CFrame.new(0, 0.45, 0), Material = slab.material, Color = slab.color,
					Reflectance = if slab.id == "gold" then 0.15 else 0, Transparency = if slab.id == "emerald" then 0.12 else 0, Parent = plot.pedestals,
				})
				make("Part", {
					Name = "Top", Size = Vector3.new(5.1, 0.25, 5.1), CFrame = cf * CFrame.new(0, 1.0, 0), Material = slab.material,
					Color = slab.color:Lerp(Color3.new(1, 1, 1), 0.25), CanCollide = false, Parent = base,
				})
				if slab.id ~= "stone" then
					for _, c in { { -2.7, -2.7 }, { 2.7, -2.7 }, { -2.7, 2.7 }, { 2.7, 2.7 } } do
						ball((cf * CFrame.new(c[1], 1, c[2])).Position, 0.6, { Name = "Stud", Material = Enum.Material.Neon, Color = if slab.id == "marble" then GOLD else slab.color, CanCollide = false, Parent = base })
					end
				end
				if slab.id == "emerald" or slab.id == "marble" then
					make("PointLight", { Color = slab.color, Range = 8, Brightness = 0.8, Parent = base })
				end
				local p = prompt(base, "PedestalPrompt", if grid[key] then "promptRemove" else "promptPlace", "slab_" .. slab.id, 6)
				p:SetAttribute("Plot", plot.index)
				p.Triggered:Connect(function(who)
					if World.onPedestal then
						World.onPedestal(who, plot.index, key)
					end
				end)
			end
		end
	end
end

local function buildPlot(index: number, slot: number, folder: Folder)
	local direction = directionAt(slot)
	local center = direction * RING
	local cf = CFrame.lookAt(center, Vector3.zero)
	local plotFolder = make("Folder", { Name = "Plot" .. index, Parent = folder })
	plotFolder:SetAttribute("OwnerId", 0)

	local floor = make("Part", { Name = "Floor", Size = Vector3.new(PLOT_SIZE, 4, PLOT_SIZE), CFrame = cf * CFrame.new(0, -2, 0), Material = Enum.Material.Grass, Color = GRASS, Parent = plotFolder })
	make("Part", { Name = "Border", Size = Vector3.new(PLOT_SIZE + 3, 3.6, PLOT_SIZE + 3), CFrame = cf * CFrame.new(0, -2.3, 0), Material = Enum.Material.Marble, Color = MARBLE, Parent = plotFolder })
	make("Part", { Name = "Trim", Size = Vector3.new(PLOT_SIZE + 4, 1, PLOT_SIZE + 4), CFrame = cf * CFrame.new(0, -4.2, 0), Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = plotFolder })
	for _ = 1, 10 do
		cloudPuff((cf * CFrame.new(rng:NextNumber(-26, 26), -9, rng:NextNumber(-26, 26))).Position, rng:NextNumber(12, 18), plotFolder, 2)
	end
	for _, c in { { -30, -30 }, { 30, -30 }, { -30, 30 }, { 30, 30 } } do
		local base = (cf * CFrame.new(c[1], 0, c[2])).Position
		flowers(base, 4, 6, plotFolder)
		pillar(base, 8, plotFolder)
		crystal(base + Vector3.new(0, 11, 0), 1.6, GLASS, plotFolder)
	end
	bridge(direction, HUB_RADIUS - 2, RING - PLOT_SIZE / 2 + 1, plotFolder)

	local post = make("Part", { Name = "SignPost", Size = Vector3.new(1, 7, 1), CFrame = cf * CFrame.new(-9, 3.5, -(PLOT_SIZE / 2 - 2)), Material = Enum.Material.SmoothPlastic, Color = GOLD, Parent = plotFolder })
	local label = worldText(post, "signFree", 5, 11, 3.2)
	label:SetAttribute("Owner", "")
	label:SetAttribute("Income", 0)

	local plot = {
		index = index,
		cf = cf,
		folder = plotFolder,
		pedestals = make("Folder", { Name = "Pedestals", Parent = plotFolder }),
		stars = make("Folder", { Name = "Stars", Parent = plotFolder }),
		markers = make("Folder", { Name = "Markers", Parent = plotFolder }),
		label = label,
		owner = nil,
		cells = {},
		builtSize = 0,
	}
	plots[index] = plot
	buildCells(plot, Config.StartGridSize, {}, {})

	local cooldown = {}
	floor.Touched:Connect(function(hit)
		local who = Players:GetPlayerFromCharacter(hit.Parent)
		if not who or plot.owner or (cooldown[who] and os.clock() - cooldown[who] < 1) then
			return
		end
		cooldown[who] = os.clock()
		if World.onPlotTouched then
			World.onPlotTouched(who, index)
		end
	end)
end

---------------------------------------------------------------- scenery
local function buildScenery(folder: Folder)
	-- sea of clouds far below
	for _ = 1, 70 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(30, 340)
		ball(Vector3.new(math.cos(a) * r, rng:NextNumber(-70, -50), math.sin(a) * r), rng:NextNumber(30, 60), {
			Name = "CloudSea", Color = CLOUD, Material = Enum.Material.SmoothPlastic, Transparency = 0.05, CanCollide = false, CastShadow = false, Parent = folder,
		})
	end

	-- rainbow behind the Forge side
	local bands = {
		Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 180, 110), Color3.fromRGB(255, 235, 130), Color3.fromRGB(150, 230, 140),
		Color3.fromRGB(130, 200, 255), Color3.fromRGB(150, 150, 255), Color3.fromRGB(200, 150, 255),
	}
	local segments = 36
	for b, color in bands do
		local radius = 200 - (b - 1) * 4
		for s = 0, segments - 1 do
			local a0 = s / segments * math.pi
			local a1 = (s + 1) / segments * math.pi
			local p0 = Vector3.new(math.cos(a0) * radius, math.sin(a0) * radius - 60, 330)
			local p1 = Vector3.new(math.cos(a1) * radius, math.sin(a1) * radius - 60, 330)
			make("Part", {
				Name = "Rainbow", Size = Vector3.new(4, 1, (p1 - p0).Magnitude + 0.4), CFrame = CFrame.lookAt((p0 + p1) / 2, p1),
				Material = Enum.Material.SmoothPlastic, Color = color, Transparency = 0.35, CanCollide = false, CastShadow = false, Parent = folder,
			})
		end
	end

	-- little floating islets with a tree or a crystal
	for i = 1, 10 do
		local a = (i + rng:NextNumber(-0.3, 0.3)) / 10 * math.pi * 2
		local r = rng:NextNumber(215, 280)
		local center = Vector3.new(math.cos(a) * r, rng:NextNumber(-15, 35), math.sin(a) * r)
		local size = rng:NextNumber(10, 16)
		cylinder(CFrame.new(center + Vector3.new(0, -1.5, 0)), 3, size, { Name = "Islet", Material = Enum.Material.Grass, Color = GRASS, Parent = folder })
		cylinder(CFrame.new(center + Vector3.new(0, -4, 0)), 3, size * 0.75, { Name = "IsletBase", Material = Enum.Material.Marble, Color = MARBLE_WARM, Parent = folder })
		cloudPuff(center + Vector3.new(0, -7, 0), size * 0.7, folder, 3)
		if i % 2 == 0 then
			tree(center, folder, Color3.fromRGB(255, 210, 230))
		else
			crystal(center + Vector3.new(0, 4, 0), 2.5, Color3.fromRGB(180, 230, 255), folder)
		end
	end

	-- hot air balloons gently bobbing
	local balloonColors = { Color3.fromRGB(255, 160, 170), Color3.fromRGB(150, 210, 255), Color3.fromRGB(255, 220, 130), Color3.fromRGB(170, 235, 190) }
	for i, color in balloonColors do
		local a = (i - 0.5) / #balloonColors * math.pi * 2 + 0.4
		local origin = Vector3.new(math.cos(a) * 205, 40 + i * 6, math.sin(a) * 205)
		local parts = {
			ball(origin, 16, { Name = "Balloon", Material = Enum.Material.SmoothPlastic, Color = color, CanCollide = false, Parent = folder }),
			make("Part", { Name = "Band", Size = Vector3.new(2, 16.4, 16.4), CFrame = CFrame.new(origin), Material = Enum.Material.SmoothPlastic, Color = MARBLE, CanCollide = false, Shape = Enum.PartType.Cylinder, Parent = folder }),
			make("Part", { Name = "Basket", Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(origin + Vector3.new(0, -13, 0)), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(170, 120, 80), CanCollide = false, Parent = folder }),
		}
		parts[2].CFrame = CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90))
		for _, corner in { { -1.6, -1.6 }, { 1.6, -1.6 }, { -1.6, 1.6 }, { 1.6, 1.6 } } do
			table.insert(parts, make("Part", {
				Name = "Rope", Size = Vector3.new(0.15, 6, 0.15), CFrame = CFrame.new(origin + Vector3.new(corner[1], -9, corner[2])),
				Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(120, 90, 60), CanCollide = false, Parent = folder,
			}))
		end
		local info = TweenInfo.new(4 + i, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		for _, part in parts do
			TweenService:Create(part, info, { CFrame = part.CFrame + Vector3.new(0, 4, 0) }):Play()
		end
	end
end

---------------------------------------------------------------- public API
function World.build()
	local okLight, errLight = pcall(setupLighting)
	if not okLight then
		warn("[World] lighting: " .. tostring(errLight))
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	local map = make("Folder", { Name = "Map", Parent = workspace })
	-- each part is guarded: a broken decoration must never take the whole game down
	local function try(name: string, fn, ...)
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[World] failed to build " .. name .. ": " .. tostring(err))
		end
	end
	try("hub", buildHub, make("Folder", { Name = "Hub", Parent = map }))
	try("forge", buildForgeHouse, make("Folder", { Name = "Forge", Parent = map }))
	try("black hole", buildBlackHole, make("Folder", { Name = "BlackHoleIsland", Parent = map }), 7) -- -Z
	local plotFolder = make("Folder", { Name = "Plots", Parent = map })
	local index = 0
	for _, slot in { 1, 2, 3, 4, 5, 6, 8 } do
		index += 1
		try("plot " .. index, buildPlot, index, slot, plotFolder)
	end
	try("scenery", buildScenery, make("Folder", { Name = "Scenery", Parent = map }))
end

function World.plotOf(player: Player): number?
	return playerPlot[player]
end

function World.claimPlot(player: Player, index: number): boolean
	local plot = plots[index]
	if not plot or plot.owner or playerPlot[player] then
		return false
	end
	plot.owner = player
	playerPlot[player] = index
	plot.folder:SetAttribute("OwnerId", player.UserId)
	plot.label:SetAttribute("Owner", player.DisplayName)
	return true
end

function World.releasePlot(player: Player)
	local index = playerPlot[player]
	if not index then
		return
	end
	local plot = plots[index]
	plot.owner = nil
	plot.folder:SetAttribute("OwnerId", 0)
	plot.label:SetAttribute("Owner", "")
	plot.label:SetAttribute("Income", 0)
	plot.stars:ClearAllChildren()
	buildCells(plot, Config.StartGridSize, {}, {})
	playerPlot[player] = nil
end

function World.spawnCFrame(player: Player): CFrame
	local index = playerPlot[player]
	if not index then
		return CFrame.new(0, 4, 20)
	end
	local cf = plots[index].cf
	local position = (cf * CFrame.new(0, 4, -(PLOT_SIZE / 2 - 5))).Position
	return CFrame.lookAt(position, cf.Position + Vector3.new(0, 4, 0))
end

function World.isNearPlot(player: Player, index: number): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local plot = plots[index]
	if not root or not plot then
		return false
	end
	local offset = root.Position - plot.cf.Position
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= Config.PlotReach
end

function World.distanceTo(player: Player, position: Vector3): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root then (root.Position - position).Magnitude else math.huge
end

-- A huge column of light over a player (server-wide rare find)
function World.lightPillar(player: Player, color: Color3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local base = root.Position
	local pillar = cylinder(CFrame.new(base + Vector3.new(0, 150, 0)), 300, 7, {
		Name = "LightPillar", Material = Enum.Material.Neon, Color = color, Transparency = 0.15, CanCollide = false, CanQuery = false, CastShadow = false, Parent = workspace,
	})
	local glow = cylinder(CFrame.new(base + Vector3.new(0, 150, 0)), 300, 16, {
		Name = "LightGlow", Material = Enum.Material.Neon, Color = color, Transparency = 0.7, CanCollide = false, CanQuery = false, CastShadow = false, Parent = workspace,
	})
	local burst = make("Part", { Name = "Burst", Size = Vector3.one, CFrame = CFrame.new(base), Transparency = 1, CanCollide = false, CanQuery = false, Parent = workspace })
	local emitter = make("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(color, Color3.new(1, 1, 1)), LightEmission = 1,
		Lifetime = NumberRange.new(1.5, 3), Speed = NumberRange.new(20, 45), SpreadAngle = Vector2.new(180, 180), Rate = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }), Parent = burst,
	})
	emitter:Emit(160)
	local info = TweenInfo.new(6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(pillar, info, { Transparency = 1 }):Play()
	TweenService:Create(glow, info, { Transparency = 1 }):Play()
	task.delay(7, function()
		pillar:Destroy()
		glow:Destroy()
		burst:Destroy()
	end)
end

local NEIGHBORS = { { 1, 0 }, { 0, 1 }, { 1, 1 }, { 1, -1 } }

function World.renderPlot(player: Player, data, evaluation, income: number)
	local index = playerPlot[player]
	if not index then
		return
	end
	local plot = plots[index]
	buildCells(plot, data.gridSize, data.slabs, data.grid)
	plot.stars:ClearAllChildren()
	plot.label:SetAttribute("Income", income)

	local function starPosition(key: string): Vector3?
		local cell = plot.cells[key]
		return cell and (cell.cf * CFrame.new(0, STAR_HEIGHT, 0)).Position
	end

	for key, cell in data.grid do
		local star, mutation = Items.parse(cell.id)
		local position = starPosition(key)
		if star and position then
			StarModels.create(star, mutation, Evolution.level(cell.age or 0), position, plot.stars)
		end
	end

	for _, group in evaluation.groups do
		local members = {}
		for _, key in group.cells do
			members[key] = true
		end
		local color = if group.pure then Color3.fromRGB(120, 210, 255) else GOLD
		for _, key in group.cells do
			local x, y = Sky.parse(key)
			for _, offset in NEIGHBORS do
				local otherKey = Sky.key(x + offset[1], y + offset[2])
				if members[otherKey] then
					local a, b = starPosition(key), starPosition(otherKey)
					if a and b then
						make("Part", {
							Name = "Line", Size = Vector3.new(0.2, 0.2, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b),
							Material = Enum.Material.Neon, Color = color, CanCollide = false, CastShadow = false, Parent = plot.stars,
						})
					end
				end
			end
		end
	end
end

return World
