	ru = { normal = "Обычная", shiny = "Сияние", golden = "Золото", void = "Пустота", celestial = "Небеса" },
}

Lang.ConstellationNames = {
	ru = {
		pair = "Двойная звезда", triangle = "Летний треугольник", belt = "Пояс Ориона", pegasus = "Квадрат Пегаса",
		rhombus = "Ромб Дельфина", cross = "Южный Крест", cassiopeia = "Кассиопея", dipper = "Большая Медведица", ring = "Кольцо Галактики",
	},
}

function Lang.t(lang: string, key: string, ...): string
	local strings = Lang.Strings[lang] or Lang.Strings.en
	local template = strings[key] or Lang.Strings.en[key] or key
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, template, ...)
		return if ok then result else template
	end
	return template
end

function Lang.star(lang: string, star): string
	local names = Lang.StarNames[lang]
	return names and names[star.id] or star.name
end

function Lang.mutation(lang: string, mutation): string
	local names = Lang.MutationNames[lang]
	return names and names[mutation.id] or mutation.name
end

function Lang.constellation(lang: string, pattern): string
	local names = Lang.ConstellationNames[lang]
	return names and names[pattern.id] or pattern.name
end

-- "Golden Pulsar" / "Пульсар · Золото"
function Lang.item(lang: string, key: string): string
	local star, mutation = Items.parse(key)
	if not star then
		return "?"
	end
	if mutation.id == "normal" then
		return Lang.star(lang, star)
	end
	if lang == "ru" then
		return Lang.star(lang, star) .. " · " .. Lang.mutation(lang, mutation)
	end
	return mutation.name .. " " .. star.name
end

-- Server sends messages as { key, args } where an arg may be { item = key } or { constellation = id }.
function Lang.resolve(lang: string, key: string, args: { any }?): string
	local Constellations = require(script.Parent.Constellations)
	local out = {}
	for i, arg in args or {} do
		if type(arg) == "table" and arg.item then
			out[i] = Lang.item(lang, arg.item)
		elseif type(arg) == "table" and arg.constellation then
			local pattern = Constellations.ById[arg.constellation]
			out[i] = if pattern then Lang.constellation(lang, pattern) else "?"
		else
			out[i] = tostring(arg)
		end
	end
	return Lang.t(lang, key, table.unpack(out))
end

return Lang
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Mutations</string><ProtectedString name="Source"><![CDATA[-- Mutations are upgrades made at the Star Forge (not rolled).
-- chance = how much rarer the star becomes (1/100K Shiny -> 1/150K), mult = income multiplier.
-- copies = how many of the previous tier you combine into one.
local Mutations = {}

Mutations.List = {
	{ id = "normal", name = "Normal", chance = 1, mult = 1, color = Color3.fromRGB(255, 255, 255) },
	{ id = "shiny", name = "Shiny", chance = 1.5, mult = 1.5, copies = 2, color = Color3.fromRGB(255, 255, 170) },
	{ id = "golden", name = "Golden", chance = 3, mult = 3, copies = 2, color = Color3.fromRGB(255, 200, 40) },
	{ id = "void", name = "Void", chance = 10, mult = 10, copies = 3, color = Color3.fromRGB(140, 60, 255) },
	{ id = "celestial", name = "Celestial", chance = 50, mult = 50, copies = 5, color = Color3.fromRGB(120, 255, 255) },
}

Mutations.ById = {}
for index, mutation in Mutations.List do
	mutation.index = index
	Mutations.ById[mutation.id] = mutation
end

return Mutations
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[local Stars = require(script.Parent.Stars)
local Mutations = require(script.Parent.Mutations)

local Odds = {}

-- From rarest down: chance luck/N each, fallback to the most common.
local function rollFrom(list, luck: number, rng: Random)
	for i = #list, 2, -1 do
		if rng:NextNumber() < math.min(1, luck / list[i].chance) then
			return list[i]
		end
	end
	return list[1]
end

-- Exact probabilities shown to players
local function exactFrom(list, luck: number): { [string]: number }
	local result = {}
	local remaining = 1
	for i = #list, 2, -1 do
		local p = math.min(1, luck / list[i].chance)
		result[list[i].id] = remaining * p
		remaining *= 1 - p
	end
	result[list[1].id] = remaining
	return result
end

-- Mutations use sqrt(luck) so luck doesn't break them
function Odds.mutationLuck(luck: number): number
	return math.sqrt(luck)
end

function Odds.roll(luck: number, rng: Random)
	return rollFrom(Stars.List, luck, rng)
end

function Odds.rollMutation(luck: number, rng: Random)
	return rollFrom(Mutations.List, Odds.mutationLuck(luck), rng)
end

function Odds.exact(luck: number)
	return exactFrom(Stars.List, luck)
end

function Odds.exactMutations(luck: number)
	return exactFrom(Mutations.List, Odds.mutationLuck(luck))
end

return Odds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Sky</string><ProtectedString name="Source"><![CDATA[-- Sky logic: find star groups, match constellations, compute income
-- grid[key] = { id = itemKey, age = seconds }
local Items = require(script.Parent.Items)
local Evolution = require(script.Parent.Evolution)
local Config = require(script.Parent.Config)
local Constellations = require(script.Parent.Constellations)

local Sky = {}

function Sky.key(x: number, y: number): string
	return x .. "_" .. y
end

function Sky.parse(key: any): (number?, number?)
	if type(key) ~= "string" then
		return nil, nil
	end
	local x, y = string.match(key, "^(%d+)_(%d+)$")
	return tonumber(x), tonumber(y)
end

local function shapeKey(cells): string
	local minX, minY = math.huge, math.huge
	for _, c in cells do
		minX = math.min(minX, c[1])
		minY = math.min(minY, c[2])
	end
	local parts = table.create(#cells)
	for i, c in cells do
		parts[i] = (c[1] - minX) .. ":" .. (c[2] - minY)
	end
	table.sort(parts)
	return table.concat(parts, ",")
end

-- 4 rotations * 2 mirrors
local transforms = {
	function(x, y) return x, y end,
	function(x, y) return -y, x end,
	function(x, y) return -x, -y end,
	function(x, y) return y, -x end,
	function(x, y) return -x, y end,
	function(x, y) return x, -y end,
	function(x, y) return y, x end,
	function(x, y) return -y, -x end,
}

local lookup = {}
for _, pattern in Constellations.List do
	for _, t in transforms do
		local moved = {}
		for i, c in pattern.cells do
			local x, y = t(c[1], c[2])
			moved[i] = { x, y }
		end
		lookup[shapeKey(moved)] = pattern
	end
end

export type Group = { id: string, pure: boolean, mult: number, cells: { string } }
export type Evaluation = { income: number, groups: { Group }, cellMult: { [string]: number } }

function Sky.evaluate(grid: { [string]: any }, size: number, slabs: { [string]: string }?): Evaluation
	local visited = {}
	local groups = {}
	local cellMult = {}
	local total = 0

	for y = 1, size do
		for x = 1, size do
			local startKey = Sky.key(x, y)
			if grid[startKey] and not visited[startKey] then
				-- flood fill the group (8 neighbors)
				visited[startKey] = true
				local stack = { { x, y } }
				local cells = {}
				while #stack > 0 do
					local c = table.remove(stack)
					table.insert(cells, c)
					for dx = -1, 1 do
						for dy = -1, 1 do
							local nx, ny = c[1] + dx, c[2] + dy
							if (dx ~= 0 or dy ~= 0) and nx >= 1 and ny >= 1 and nx <= size and ny <= size then
								local nk = Sky.key(nx, ny)
								if grid[nk] and not visited[nk] then
									visited[nk] = true
									table.insert(stack, { nx, ny })
								end
							end
						end
					end
				end

				local keys = table.create(#cells)
				for i, c in cells do
					keys[i] = Sky.key(c[1], c[2])
				end

				local mult = 1
				local pattern = Config.ConstellationsEnabled and lookup[shapeKey(cells)]
				if pattern then
					local first = Items.parse(grid[keys[1]].id)
					local pure = true
					for _, k in keys do
						if Items.parse(grid[k].id) ~= first then
							pure = false
							break
						end
					end
					mult = pattern.mult * (if pure then Constellations.PureBonus else 1)
					table.insert(groups, { id = pattern.id, pure = pure, mult = mult, cells = keys })
				end

				for _, k in keys do
					local cell = grid[k]
					local slab = slabs and Config.SlabsById[slabs[k]]
					total += Items.income(cell.id) * Evolution.mult(cell.age or 0) * mult * (if slab then slab.mult else 1)
					cellMult[k] = mult
				end
			end
		end
	end

	return { income = total, groups = groups, cellMult = cellMult }
end

return Sky
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Stars</string><ProtectedString name="Source"><![CDATA[-- chance = "1 in N", income = cash per second while placed on the sky
-- evolvesTo = what it can explode into at max evolution level
-- kind = which look (icon + 3D model) a named star borrows
